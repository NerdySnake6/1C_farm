&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Продажи за период";
    АвтоЗаголовок = Ложь;
    ЦветФона = Новый Цвет(248, 246, 238);
    НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
    КонецПериода = КонецДня(ТекущаяДатаСеанса());
    ДобавитьПоле("НачалоПериода", "НачалоПериода", "С даты");
    ДобавитьПоле("КонецПериода", "КонецПериода", "По дату");
    Элементы.КонецПериода.Формат = "ДФ=dd.MM.yyyy";
    ДобавитьПоле("ОтборОрганизация", "ОтборОрганизация", "Организация");
    ДобавитьПоле("ОтборСклад", "ОтборСклад", "Склад");
    ДобавитьКнопку("СформироватьОтчет", "Сформировать отчёт");
    ДобавитьКнопку("СброситьОтборы", "Все организации и склады");
    ДобавитьКнопку("ПечатьОтчета", "Печать отчёта");
    Поле = Элементы.Добавить("РезультатОтчета", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "РезультатОтчета";
    Поле.Заголовок = "Данные отчёта";
    Поле.ТолькоПросмотр = Истина;
    ДобавитьКонтрольОтчетаVanessa();
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда) Экспорт
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда) Экспорт
    ОтборОрганизация = Неопределено;
    ОтборСклад = Неопределено;
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчета(Команда)
    РезультатОтчета.Напечатать();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Если Истина И НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода должно быть не позже конца периода.");
        Возврат;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Т.Ссылка.Организация КАК Организация, Т.Ссылка.Покупатель КАК Покупатель, Т.Номенклатура КАК Продукция, Т.Номенклатура.ЕдиницаИзмерения КАК Единица, СУММА(Т.Количество) КАК Количество, СУММА(Т.Сумма) КАК Сумма ИЗ Документ.Расход.Товары КАК Т ГДЕ Т.Ссылка.Проведен И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец И (&ВсеОрганизации ИЛИ Т.Ссылка.Организация = &Организация) И (&ВсеСклады ИЛИ Т.Ссылка.Склад = &Склад) СГРУППИРОВАТЬ ПО Т.Ссылка.Организация, Т.Ссылка.Покупатель, Т.Номенклатура, Т.Номенклатура.ЕдиницаИзмерения УПОРЯДОЧИТЬ ПО Организация, Покупатель, Продукция";
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
    Запрос.УстановитьПараметр("Склад", ОтборСклад);
    Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(ОтборОрганизация));
    Запрос.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(ОтборСклад));
    Таблица = Запрос.Выполнить().Выгрузить();
    РезультатОтчета.Очистить();
    РезультатОтчета.АвтоМасштаб = Истина;
    РезультатОтчета.Область(1, 1).Текст = "Продажи за период";
    РезультатОтчета.Область(1, 1).Шрифт = Новый Шрифт(, 14, Истина);
    РезультатОтчета.Область(2, 1).Текст = "Дата отчёта: " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
    Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
        Ячейка = РезультатОтчета.Область(4, Индекс + 1);
        Ячейка.Текст = ?(Таблица.Колонки[Индекс].Имя = "Единица", "Ед. изм.", Таблица.Колонки[Индекс].Имя);
        Ячейка.ЦветФона = Новый Цвет(47, 107, 79);
        Ячейка.ЦветТекста = Новый Цвет(255, 255, 255);
        Ячейка.Шрифт = Новый Шрифт(, 10, Истина);
        РезультатОтчета.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = 25;
    КонецЦикла;
    НомерСтроки = 5;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
            Ячейка = РезультатОтчета.Область(НомерСтроки, Индекс + 1);
            Если ТипЗнч(СтрокаТаблицы[Индекс]) = Тип("Число") Тогда
                Ячейка.СодержитЗначение = Истина;
                Ячейка.Значение = СтрокаТаблицы[Индекс];
            Иначе
                Ячейка.Текст = Строка(СтрокаТаблицы[Индекс]);
            КонецЕсли;
            Если НомерСтроки % 2 = 0 Тогда
                Ячейка.ЦветФона = Новый Цвет(237, 244, 237);
            КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    РезультатОтчета.Область(НомерСтроки + 1, 1).Текст = "Итого продаж, руб.";
    Ячейка = РезультатОтчета.Область(НомерСтроки + 1, Таблица.Колонки.Количество());
    Ячейка.СодержитЗначение = Истина;
    Ячейка.Значение = Таблица.Итог("Сумма");
    Ячейка.Формат = "ЧДЦ=2";

    Если Таблица.Количество() = 0 Тогда
        РезультатОтчета.Область(5, 1).Текст = "По выбранным условиям данных нет";
    КонецЕсли;
    ПоказатьКонтрольОтчетаVanessa(Таблица.Количество(), Истина);
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Имя, Путь, Заголовок, Родитель = Неопределено)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
    Команда = Команды.Добавить(Имя);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
    Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
    Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    Если Имя = "УдалитьСтроку" Или Имя = "СброситьОтборы"
        Или Имя = "ОткрытьПриходы" Или Имя = "ОткрытьРасходы" Тогда
        Кнопка.ЦветФона = Новый Цвет(230, 239, 231);
        Кнопка.ЦветТекста = Новый Цвет(32, 56, 44);
    КонецЕсли;
КонецПроцедуры

// Только база с подготовленными Vanessa-фикстурами. Без привилегированного режима.
&НаСервере
Процедура ДобавитьКонтрольОтчетаVanessa()
    КаталогБазы = "";
    Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";") Цикл
        Часть = СокрЛП(Часть);
        Если ВРег(Лев(Часть, 5)) = "FILE=" Тогда
            КаталогБазы = СтрЗаменить(Сред(Часть, 6), """", "");
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(КаталогБазы) Тогда Возврат; КонецЕсли;
    ФайлФикстур = Новый Файл(КаталогБазы + "/farm-vanessa-fixtures.bin");
    Если Не ФайлФикстур.Существует() Тогда Возврат; КонецЕсли;
    Для Каждого Имя Из СтрРазделить("Строк;Количество;Резерв;Доступно;СуммаСтрок;Итого;Организация;Роль;Приход;Расход;Бронь;Цены;Администрирование", ";") Цикл
        Надпись = Элементы.Добавить("VAОтчет" + Имя, Тип("ДекорацияФормы"));
        Надпись.Вид = ВидДекорацииФормы.Надпись;
        Надпись.Заголовок = "Не проверено";
        Надпись.Подсказка = Имя;
    КонецЦикла;
    Элементы.VAОтчетРоль.Заголовок = ?(РольДоступна("ПолныеПрава"), "Администратор", ?(РольДоступна("Покупка"), "Покупка", "Продажа"));
    Элементы.VAОтчетПриход.Заголовок = ?(ПравоДоступа("Проведение", Метаданные.Документы.Приход), "Да", "Нет");
    Элементы.VAОтчетРасход.Заголовок = ?(ПравоДоступа("Проведение", Метаданные.Документы.Расход), "Да", "Нет");
    Элементы.VAОтчетБронь.Заголовок = ?(ПравоДоступа("Проведение", Метаданные.Документы.Бронирование), "Да", "Нет");
    Элементы.VAОтчетЦены.Заголовок = ?(ПравоДоступа("Изменение", Метаданные.РегистрыСведений.Цены), "Да", "Нет");
    Элементы.VAОтчетАдминистрирование.Заголовок = ?(ПравоДоступа("Администрирование", Метаданные), "Да", "Нет");
КонецПроцедуры

&НаСервере
Процедура ПоказатьКонтрольОтчетаVanessa(КоличествоСтрок, ЭтоПродажи)
    Если Элементы.Найти("VAОтчетСтрок") = Неопределено Тогда Возврат; КонецЕсли;
    Количество = 0;
    Резерв = 0;
    Доступно = 0;
    СуммаСтрок = 0;
    Для Номер = 5 По 4 + КоличествоСтрок Цикл
        Количество = Количество + РезультатОтчета.Область(Номер, 5).Значение;
        Если ЭтоПродажи Тогда
            СуммаСтрок = СуммаСтрок + РезультатОтчета.Область(Номер, 6).Значение;
        Иначе
            Резерв = Резерв + РезультатОтчета.Область(Номер, 6).Значение;
            Доступно = Доступно + РезультатОтчета.Область(Номер, 7).Значение;
        КонецЕсли;
    КонецЦикла;
    Итог = 0;
    Если ЭтоПродажи Тогда
        Итог = Число(СтрЗаменить(СтрЗаменить(Строка(РезультатОтчета.Область(6 + КоличествоСтрок, 6).Значение), Символ(160), ""), " ", ""));
    КонецЕсли;
    Значения = Новый Структура("Строк,Количество,Резерв,Доступно,СуммаСтрок,Итого", КоличествоСтрок, Количество, Резерв, Доступно, СуммаСтрок, Итог);
    Для Каждого Пара Из Значения Цикл
        Элементы["VAОтчет" + Пара.Ключ].Заголовок = Формат(Пара.Значение, "ЧГ=0;ЧДЦ=0;ЧН=0");
    КонецЦикла;
    Элементы.VAОтчетОрганизация.Заголовок = ?(КоличествоСтрок = 1, РезультатОтчета.Область(5, 1).Текст, "");
КонецПроцедуры
