&НаСервере
Процедура ПоказатьПротоколПроверок(Итог)
    Статусы = Новый Соответствие;
    Ошибки = Новый Массив;
    Если Итог <> Неопределено Тогда
        Для Каждого Строка Из Итог.Линии Цикл
            Если Лев(Строка, 7) = "PASS | " Тогда
                Код = СтрРазделить(Сред(Строка, 8), " ")[0];
                Статусы.Вставить(Код, "ПРОЙДЕН");
            ИначеЕсли Лев(Строка, 7) = "FAIL | " Тогда
                Код = СтрРазделить(Сред(Строка, 8), " ")[0];
                Статусы.Вставить(Код, "ОШИБКА");
                Ошибки.Добавить(Строка);
            ИначеЕсли Строка <> "COMPLETE" Тогда
                Ошибки.Добавить(Строка);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Документ = Новый ТабличныйДокумент;
    Документ.ОтображатьСетку = Ложь;
    Документ.Область(1, 1).Текст = "Результат";
    Документ.Область(1, 2).Текст = "Код";
    Документ.Область(1, 3).Текст = "Действие теста: что выполняем";
    Документ.Область(1, 4).Текст = "Ожидаемый результат: что проверяем";
    Документ.Область(1, 1, 1, 4).ЦветФона = Новый Цвет(230, 239, 231);
    Документ.Область(1, 1, 1, 4).Шрифт = Новый Шрифт(, 11, Истина);
    Номер = 2;
    Для Каждого Описание Из ОписанияПроверок() Цикл
        Статус = Статусы.Получить(Описание.Код);
        Если Статус = Неопределено Тогда
            Статус = ?(Итог = Неопределено, "НЕ ЗАПУЩЕН", "НЕ ВЫПОЛНЕН");
        КонецЕсли;
        Документ.Область(Номер, 1).Текст = Статус;
        Документ.Область(Номер, 1).ЦветТекста = ?(Статус = "ПРОЙДЕН", Новый Цвет(47, 107, 79), Новый Цвет(145, 65, 35));
        Документ.Область(Номер, 2).Текст = Описание.Код;
        Документ.Область(Номер, 3).Текст = Описание.Действие;
        Документ.Область(Номер, 4).Текст = Описание.Ожидание;
        Если Номер % 2 = 0 Тогда
            Документ.Область(Номер, 1, Номер, 4).ЦветФона = Новый Цвет(247, 249, 246);
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Для Каждого Строка Из Ошибки Цикл
        Документ.Область(Номер, 1).Текст = "ОШИБКА";
        Документ.Область(Номер, 3, Номер, 4).Объединить();
        Документ.Область(Номер, 3).Текст = Строка;
        Документ.Область(Номер, 1, Номер, 4).ЦветТекста = Новый Цвет(180, 40, 40);
        Номер = Номер + 1;
    КонецЦикла;
    Документ.Область(, 1, , 1).ШиринаКолонки = 16;
    Документ.Область(, 2, , 2).ШиринаКолонки = 8;
    Документ.Область(, 3, , 3).ШиринаКолонки = 60;
    Документ.Область(, 4, , 4).ШиринаКолонки = 70;
    Область = Документ.Область(1, 1, Номер - 1, 4);
    Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
    Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
    Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    Документ.Область(2, 1, Номер - 1, 4).Шрифт = Новый Шрифт(, 11);
    Результат = Документ;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиФорм(Запуск, Протокол)
    ФормаБрони = Неопределено;
    Попытка
            СсылкаБрони = СервисФермы.БроньВстроенногоТеста(Запуск);
            ФормаБрони = ПолучитьФорму("Документ.Бронирование.Форма.Форма", Новый Структура("Ключ", СсылкаБрони));
            ФормаБрони.Открыть();
            Если ФормаБрони.Команды.Найти("ПродатьБронь") = Неопределено Или ФормаБрони.СостояниеБрони <> "Действует" Тогда
                ВызватьИсключение "Не созданы команды или состояние брони";
            КонецЕсли;
            Протокол.Добавить("PASS | BF01 Форма брони и состояние созданы");
            НоваяФормаБрони = ПолучитьФорму("Документ.Бронирование.Форма.Форма");
            Если НоваяФормаБрони.Элементы.ДействияБрони.Видимость
                Или Не ФормаБрони.Элементы.ДействияБрони.Видимость
                Или ФормаБрони.Элементы.СрокБрони.Родитель.Имя <> "УсловияБрони"
                Или ФормаБрони.Элементы.Товары.Родитель.Имя <> "СоставБрони" Тогда
                ВызватьИсключение "Неверная компоновка формы или видимость действий";
            КонецЕсли;
            Протокол.Добавить("PASS | BF07 Группы полей и видимость действий");
            ФормаБрони.ПродатьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) <> "Продано" Тогда ВызватьИсключение "Кнопка не продала бронь"; КонецЕсли;
            Протокол.Добавить("PASS | BF02 Обработчик Продать по брони создает проведенную продажу");
            ОтказПовтора = Ложь;
            Попытка
                ФормаБрони.ПродатьБронь(Неопределено);
            Исключение
                ОшибкаПовтора = ИнформацияОбОшибке();
                Пока ОшибкаПовтора.Причина <> Неопределено Цикл ОшибкаПовтора = ОшибкаПовтора.Причина; КонецЦикла;
                ОтказПовтора = СервисФермы.ПричинаСовпадает(ОшибкаПовтора.Описание,
                    "По этой брони уже есть проведённая продажа.");
            КонецПопытки;
            Если Не ОтказПовтора Тогда ВызватьИсключение "Повторная продажа по кнопке не отклонена"; КонецЕсли;
            Протокол.Добавить("PASS | BF03 Повторная команда продажи отклонена [Ожидаемый отказ подтвержден: по этой брони уже есть продажа]");
            СервисФермы.ОтменитьПродажуТестаБрони(СсылкаБрони);
            ФормаБрони.ОтменитьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) = "Действует" Тогда ВызватьИсключение "Команда не отменила бронь"; КонецЕсли;
            Протокол.Добавить("PASS | BF04 Обработчик Отменить бронь снимает резерв");
            Если Не ФормаБрони.Элементы.ИсторияСнятия.Видимость
                Или ФормаБрони.Элементы.ДействияБрони.Видимость
                Или Не ЗначениеЗаполнено(ФормаБрони.Объект.ДатаСнятия)
                Или ФормаБрони.Объект.АвторСнятия <> ИмяПользователя()
                Или ФормаБрони.Объект.ПричинаСнятия <> "Ручная отмена"
                Или Не ФормаБрони.Элементы.ПричинаСнятия.ТолькоПросмотр Тогда
                ВызватьИсключение "Реквизиты ручного снятия брони не подтверждены";
            КонецЕсли;
            Протокол.Добавить("PASS | BF08 История ручного снятия и видимость действий");
            ОтчетБрони = ПолучитьФорму("Отчет.ДоступностьПродукции.Форма.Форма");
            ОтчетБрони.СформироватьОтчет(Неопределено);
            Если ОтчетБрони.РезультатОтчета.Область(4, 5).Текст <> "Остаток"
                Или ОтчетБрони.РезультатОтчета.Область(4, 6).Текст <> "Забронировано"
                Или ОтчетБрони.РезультатОтчета.Область(4, 7).Текст <> "Доступно" Тогда
                ВызватьИсключение "Отчет не показывает свободный остаток";
            КонецЕсли;
            Протокол.Добавить("PASS | BF05 Отчет содержит склад, резерв и свободный остаток");
            ПанельБрони = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
            Если ПанельБрони.Команды.Найти("СоздатьБронь") = Неопределено Или ПанельБрони.Команды.Найти("ОткрытьБрони") = Неопределено Тогда
                ВызватьИсключение "Нет команд брони в разделе Продажа";
            КонецЕсли;
            Протокол.Добавить("PASS | BF06 На странице Продажа есть создание и журнал броней");
            РабочийСтолБрони = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            Если РабочийСтолБрони.Элементы.СоздатьРасход.Родитель.Имя <> "СозданиеДокументов"
                Или РабочийСтолБрони.Элементы.ОткрытьРасходы.Родитель.Имя <> "ЖурналыДокументов" Тогда
                ВызватьИсключение "Команды продажи на рабочем столе не совпали с ожидаемыми";
            КонецЕсли;
            Протокол.Добавить("PASS | BF09 Создание продажи и журнал находятся в разных группах");
            Протокол.Добавить("COMPLETE");
    Исключение
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    Для Каждого СсылкаПродажи Из СервисФермы.ПродажиВстроенногоТеста(Запуск) Цикл
        Попытка
            ФормаПродажи = ПолучитьФорму("Документ.Расход.ФормаОбъекта", Новый Структура("Ключ", СсылкаПродажи));
            ФормаПродажи.Закрыть();
        Исключение
            Протокол.Добавить("ERROR | Закрытие продажи: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
    Если ФормаБрони <> Неопределено Тогда
        Попытка ФормаБрони.Закрыть(); Исключение Протокол.Добавить("ERROR | Закрытие формы: " + ОписаниеОшибки()); КонецПопытки;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьVanessa(Команда) Экспорт
    ПоказатьТаблицуVanessa(Неопределено, "ОЖИДАНИЕ");
    Попытка
        Запуск = ПодготовитьЗапускVanessa();
        ИдентификаторVanessa = Запуск.Идентификатор;
        СрокОжиданияVanessa = ТекущаяДата() + 900;
        НачатьЗапускПриложения(Новый ОписаниеОповещения, Запуск.Команда);
        Элементы.ЗапуститьVanessa.Доступность = Ложь;
        Элементы.ИтогVanessa.Заголовок = "Vanessa: подготовка отдельной тестовой базы...";
        ПодключитьОбработчикОжидания("ПроверитьРезультатVanessa", 2);
        ОбработчикVanessaПодключен = Истина;
    Исключение
        Элементы.ИтогVanessa.Заголовок = "Vanessa не запущена: " + ОписаниеОшибки();
        ПоказатьТаблицуVanessa(Новый Структура("Проверки,Ошибка", Новый Массив, ОписаниеОшибки()), "НЕ ВЫПОЛНЕН");
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРезультатVanessa() Экспорт
    Попытка
        Итог = ПолучитьРезультатVanessa(ИдентификаторVanessa);
        Если Итог.status = "passed" Тогда
            ПоказатьТаблицуVanessa(Итог, "НЕ ВЫПОЛНЕН");
            Элементы.ИтогVanessa.Заголовок = "Vanessa: ПРОЙДЕНО 18 ИЗ 18";
        ИначеЕсли Итог.status = "failed" Тогда
            ПоказатьТаблицуVanessa(Итог, "НЕ ВЫПОЛНЕН");
            Элементы.ИтогVanessa.Заголовок = "Vanessa: проверки не пройдены. Подробности: " + Итог.Каталог;
        ИначеЕсли ТекущаяДата() > СрокОжиданияVanessa Тогда
            Элементы.ИтогVanessa.Заголовок = "Vanessa: время ожидания истекло. Проверьте окно менеджера тестирования.";
            ПоказатьТаблицуVanessa(Итог, "НЕ ВЫПОЛНЕН");
        Иначе
            Если Итог.status = "running" Тогда
                Элементы.ИтогVanessa.Заголовок = "Vanessa: выполняются 18 сценариев. При запросе 1С разрешите открытие обработки.";
            КонецЕсли;
            Возврат;
        КонецЕсли;
    Исключение
        Элементы.ИтогVanessa.Заголовок = "Vanessa: не удалось прочитать результат. " + ОписаниеОшибки();
    КонецПопытки;
    Если ОбработчикVanessaПодключен = Истина Тогда
        ОтключитьОбработчикОжидания("ПроверитьРезультатVanessa");
        ОбработчикVanessaПодключен = Ложь;
    КонецЕсли;
    Элементы.ЗапуститьVanessa.Доступность = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиЗапускаVanessa()
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Vanessa доступна администратору учебной базы.";
    КонецЕсли;
    КаталогБазы = "";
    Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";") Цикл
        Часть = СокрЛП(Часть);
        Если ВРег(Лев(Часть, 5)) = "FILE=" Тогда
            КаталогБазы = СтрЗаменить(Сред(Часть, 6), """", "");
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(КаталогБазы) Тогда
        ВызватьИсключение "Запуск настроен для локальной учебной базы.";
    КонецЕсли;
    Путь = КаталогБазы + "/farm-vanessa-launch.json";
    ФайлПути = Новый Файл(Путь);
    Если Не ФайлПути.Существует() Тогда
        ВызватьИсключение "Подготовьте запуск Vanessa для этой базы по docs/vanessa.md.";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь);
    Попытка
        Настройки = ПрочитатьJSON(Чтение);
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение;
    КонецПопытки;
    Чтение.Закрыть();
    Возврат Настройки;
КонецФункции

&НаСервереБезКонтекста
Функция АргументЗапускаVanessa(Значение)
    Если СтрНайти(Значение, """") > 0 Или СтрНайти(Значение, Символы.ПС) > 0
        Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Некорректный путь в настройках Vanessa.";
    КонецЕсли;
    Возврат """" + Значение + """";
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьЗапускVanessa()
    Настройки = НастройкиЗапускаVanessa();
    ФайлPython = Новый Файл(Настройки.Python);
    ФайлRunner = Новый Файл(Настройки.Runner);
    Если Не ФайлPython.Существует() Или Не ФайлRunner.Существует() Тогда
        ВызватьИсключение "Не найдены средства запуска Vanessa. Обновите локальные настройки.";
    КонецЕсли;
    Идентификатор = Строка(Новый УникальныйИдентификатор);
    СоздатьКаталог(Настройки.Results);
    ПутьРезультата = Настройки.Results + "/" + Идентификатор + ".json";
    Команда = АргументЗапускаVanessa(Настройки.Python) + " " + АргументЗапускаVanessa(Настройки.Runner)
        + " --ui-result " + АргументЗапускаVanessa(ПутьРезультата);
    Возврат Новый Структура("Идентификатор,Команда", Идентификатор, Команда);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРезультатVanessa(Идентификатор)
    Настройки = НастройкиЗапускаVanessa();
    Идентификатор = Строка(Новый УникальныйИдентификатор(Идентификатор));
    Путь = Настройки.Results + "/" + Идентификатор + ".json";
    ФайлПути = Новый Файл(Путь);
    Если Не ФайлПути.Существует() Тогда
        Возврат Новый Структура("status", "preparing");
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь);
    Попытка
        Данные = ПрочитатьJSON(Чтение, Истина);
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение;
    КонецПопытки;
    Чтение.Закрыть();
    Статус = Данные.Получить("status");
    Если Статус <> "preparing" И Статус <> "running" И Статус <> "passed" И Статус <> "failed" Тогда
        ВызватьИсключение "Неизвестный статус результата Vanessa.";
    КонецЕсли;
    Проверки = Новый Массив;
    Если Данные.Получить("scenario_results") <> Неопределено Тогда
        Для Каждого Проверка Из Данные.Получить("scenario_results") Цикл
            Проверки.Добавить(Новый Структура("code,status,duration,detail",
                Проверка.Получить("code"), Проверка.Получить("status"),
                Проверка.Получить("duration"), Проверка.Получить("detail")));
        КонецЦикла;
    КонецЕсли;
    Ошибки = "";
    Для Каждого Ключ Из СтрРазделить("error;cleanup_error;report_error", ";") Цикл
        Если Данные.Получить(Ключ) <> Неопределено Тогда
            Ошибки = Ошибки + Строка(Данные.Получить(Ключ)) + Символы.ПС;
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("status,Каталог,Проверки,Ошибка", Статус, Настройки.Results, Проверки, Ошибки);
КонецФункции

&НаСервере
Процедура ДобавитьКонтрольОперацийVanessa()
    Если Не СервисФермы.ДоступенКонтрольПрямыхСценариевVanessa() Тогда Возврат; КонецЕсли;
    Блок = Элементы.Добавить("СлужебныеДанныеVanessa", Тип("ГруппаФормы"));
    Блок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Блок.Заголовок = "Служебные данные автотестов";
    Блок.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
    Подпись = Элементы.Добавить("ПояснениеКонтроляVanessa", Тип("ДекорацияФормы"), Блок);
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Эти кнопки читает Vanessa. Они показывают данные отдельного сценария и не изменяют их. Для обычного запуска используйте «Запустить Vanessa».";
    Подпись.Ширина = 95;
    Индекс = 0;
    Для Каждого Код Из СтрРазделить("VA04;VA05;VA06;VA07;VA08;VA09;VA10;VA11;VA12;VA13;VA14;VA15;VA16;VA17;VA18", ";") Цикл
        Если Индекс % 3 = 0 Тогда
            РядКнопок = Элементы.Добавить("РядКонтроляVanessa" + Строка(Индекс), Тип("ГруппаФормы"), Блок);
            РядКнопок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
            РядКнопок.ОтображатьЗаголовок = Ложь;
            РядКнопок.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
        КонецЕсли;
        Команда = Команды.Добавить("Контроль" + Код);
        Команда.Заголовок = "Проверить данные " + Код;
        Команда.Действие = "ПоказатьКонтрольОперацийVanessa";
        Кнопка = Элементы.Добавить("Контроль" + Код, Тип("КнопкаФормы"), РядКнопок);
        Кнопка.ИмяКоманды = "Контроль" + Код;
        Индекс = Индекс + 1;
    КонецЦикла;
    Подпись = Элементы.Добавить("ВыбранныйСценарийVanessa", Тип("ДекорацияФормы"), Блок);
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Сценарий ещё не выбран";
    Подпись.Шрифт = Новый Шрифт(, 11, Истина);
    Названия = Новый Структура("Остаток,Резерв,Доступно,Продаж,ПриходПроведен,БроньПроведена,СостояниеБрони",
        "Остаток на складе", "Забронировано", "Доступно для продажи", "Проведённых продаж", "Приход проведён", "Бронь проведена", "Состояние брони");
    Для Каждого Описание Из Названия Цикл
        Имя = Описание.Ключ;
        Ряд = Элементы.Добавить("РядЗначенияVanessa" + Имя, Тип("ГруппаФормы"), Блок);
        Ряд.Вид = ВидГруппыФормы.ОбычнаяГруппа;
        Ряд.ОтображатьЗаголовок = Ложь;
        Ряд.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
        Подпись = Элементы.Добавить("НазваниеКонтроля" + Имя, Тип("ДекорацияФормы"), Ряд);
        Подпись.Вид = ВидДекорацииФормы.Надпись;
        Подпись.Заголовок = Описание.Значение + ":";
        Подпись.Ширина = 28;
        Надпись = Элементы.Добавить("Контроль" + Имя, Тип("ДекорацияФормы"), Ряд);
        Надпись.Вид = ВидДекорацииФормы.Надпись;
        Надпись.Заголовок = "Не проверено";
        Надпись.Подсказка = Описание.Значение;
        Надпись.Ширина = 20;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКонтрольОперацийVanessa(Команда)
    КодСценария = Сред(Команда.Имя, СтрДлина("Контроль") + 1);
    Контроль = ДанныеКонтроляОперацийVanessa(КодСценария);
    Элементы.ВыбранныйСценарийVanessa.Заголовок = "Данные сценария " + КодСценария;
    Для Каждого Пара Из Контроль Цикл
        Если ТипЗнч(Пара.Значение) = Тип("Булево") Тогда
            Текст = ?(Пара.Значение, "Да", "Нет");
        ИначеЕсли ТипЗнч(Пара.Значение) = Тип("Число") Тогда
            Текст = Формат(Пара.Значение, "ЧГ=0;ЧДЦ=0;ЧН=0");
        Иначе
            Текст = Строка(Пара.Значение);
        КонецЕсли;
        Элементы["Контроль" + Пара.Ключ].Заголовок = Текст;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеКонтроляОперацийVanessa(Код)
    Возврат СервисФермы.КонтрольПрямогоСценарияVanessa(Код);
КонецФункции

&НаСервере
Функция ОписанияСценариевVanessa()
    Описания = Новый Массив;
    ДобавитьОписаниеПроверки(Описания, "VA01", "Открываем экран проверок с рабочего стола.", "Экран открыт, показана готовность к запуску; старого результата нет.");
    ДобавитьОписаниеПроверки(Описания, "VA02", "Дважды нажимаем «Запустить 41 проверку» в одном экране.", "После каждого запуска показано «ПРОЙДЕНО 41 ИЗ 41».");
    ДобавитьОписаниеПроверки(Описания, "VA03", "Запускаем 41 проверку, закрываем экран и открываем снова.", "Сначала 41/41; после открытия показана готовность к новому запуску.");
    ДобавитьОписаниеПроверки(Описания, "VA04", "Вводим 100 в приходе, проверяем сумму 9000 и проводим.", "Остаток 100, резерв 0, доступно 100; приход проведён.");
    ДобавитьОписаниеПроверки(Описания, "VA05", "Приход 75 → бронь 20 → продажа по брони → отмена продажи → отмена брони.", "Остаток/резерв: 75/0 → 75/20 → 55/0 → 75/20 → 75/0. Состояния документов соответствуют операциям.");
    ДобавитьОписаниеПроверки(Описания, "VA06", "При остатке 75 и резерве 20 пытаемся продать 56.", "Отказ: недостаточно свободной продукции, нехватка 1. Остаток 75, резерв 20; проведённых продаж нет.");
    ДобавитьОписаниеПроверки(Описания, "VA07", "Повторно проводим приход 75, бронь 20 и продажу 55.", "Приход и бронь: 75/20. После продажи и её повторного проведения: остаток 20, резерв 20, одна продажа.");
    ДобавитьОписаниеПроверки(Описания, "VA08", "При остатке 75 и резерве 20 продаём ровно 55 свободных единиц.", "Продажа проведена; остаток 20, резерв 20, доступно 0. Действующая бронь сохранена.");
    ДобавитьОписаниеПроверки(Описания, "VA09", "При свободных 55 пытаемся провести новую бронь 56.", "Отказ: недостаточно свободной продукции, нехватка 1. Остаток 75, резерв 20, продаж нет.");
    ДобавитьОписаниеПроверки(Описания, "VA10", "Отменяем проведение прихода 75 под действующей бронью 20.", "Отказ: недостаточно свободной продукции, нехватка 20. Приход и бронь проведены; остаток 75, резерв 20.");
    ДобавитьОписаниеПроверки(Описания, "VA11", "Продаём бронь 20 и пытаемся провести вторую продажу по той же брони.", "Отказ: по брони уже проведена продажа. Остаток 55, резерв 0, продажа одна, бронь продана.");
    ДобавитьОписаниеПроверки(Описания, "VA12", "После продажи по брони пробуем отменить проведение брони.", "Отказ: сначала отмените связанную продажу. Остаток 55, резерв 0; бронь проведена и продана.");
    ДобавитьОписаниеПроверки(Описания, "VA13", "Пытаемся провести продажу с количеством 0, затем −1.", "Оба раза отказ: требуется положительное количество. Остаток 75, резерв 20; продаж нет.");
    ДобавитьОписаниеПроверки(Описания, "VA14", "Проводим черновик брони со сроком, истёкшим вчера.", "Отказ: срок действия брони истёк. Черновик не проведён, резерв 0, остаток и доступность 75.");
    ДобавитьОписаниеПроверки(Описания, "VA15", "Под ролью «Покупка» проводим приход 75; проверяем команды и права.", "Приход разрешён, продажа/бронь/администрирование запрещены; цены изменять можно. Отчёт 75/0/75.");
    ДобавитьОписаниеПроверки(Описания, "VA16", "Под ролью «Продажа» продаём бронь 20; проверяем команды и права.", "Продажа/бронь разрешены; приход/изменение цен/администрирование запрещены. Отчёты 55/0/55 и20/1800руб.");
    ДобавитьОписаниеПроверки(Описания, "VA17", "Формируем остатки и доступность до продажи 55, после неё и после отмены.", "Оба отчёта: 75/20/55 → 20/20/0 → 75/20/55. Отборы ограничивают данные своей организацией и складом.");
    ДобавитьОписаниеПроверки(Описания, "VA18", "Формируем отчёт продаж до продажи брони20, после неё и после отмены.", "Сначала0 строк/0руб.; затем количество20, сумма строки и итог1800руб.; после отмены снова0/0.");
    Возврат Описания;
КонецФункции

&НаСервере
Процедура ПоказатьТаблицуVanessa(Итог = Неопределено, Состояние = "НЕ ЗАПУЩЕН")
    СтрокиРезультата = Новый Соответствие;
    Если Итог <> Неопределено Тогда
        Для Каждого Проверка Из Итог.Проверки Цикл
            СтрокиРезультата.Вставить(Проверка.code, Проверка);
        КонецЦикла;
    КонецЕсли;
    Документ = Новый ТабличныйДокумент;
    Документ.ОтображатьСетку = Ложь;
    Заголовки = СтрРазделить("Результат;Код;Действие теста: что выполняем;Ожидаемый результат;Подробности прогона", ";");
    Для Колонка = 1 По 5 Цикл
        Документ.Область(1, Колонка).Текст = Заголовки[Колонка - 1];
    КонецЦикла;
    Документ.Область(1, 1, 1, 5).ЦветФона = Новый Цвет(230, 239, 231);
    Документ.Область(1, 1, 1, 5).Шрифт = Новый Шрифт(, 11, Истина);
    Номер = 2;
    Для Каждого Описание Из ОписанияСценариевVanessa() Цикл
        Статус = Состояние;
        Подробности = "";
        Проверка = СтрокиРезультата.Получить(Описание.Код);
        Если Проверка <> Неопределено Тогда
            Если Проверка.status = "passed" Тогда
                Статус = "ПРОЙДЕН";
            ИначеЕсли Проверка.status = "skipped" Тогда
                Статус = "ПРОПУЩЕН";
            Иначе
                Статус = "ОШИБКА";
            КонецЕсли;
            Подробности = Проверка.detail;
            Если Не ПустаяСтрока(Проверка.duration) Тогда
                Подробности = "Время: " + Проверка.duration + " с" + Символы.ПС + Подробности;
            КонецЕсли;
        КонецЕсли;
        Документ.Область(Номер, 1).Текст = Статус;
        Документ.Область(Номер, 2).Текст = Описание.Код;
        Документ.Область(Номер, 3).Текст = Описание.Действие;
        Документ.Область(Номер, 4).Текст = Описание.Ожидание;
        Документ.Область(Номер, 5).Текст = Подробности;
        Если Номер % 2 = 0 Тогда
            Документ.Область(Номер, 1, Номер, 5).ЦветФона = Новый Цвет(247, 249, 246);
        КонецЕсли;
        Документ.Область(Номер, 1).ЦветТекста = ?(Статус = "ПРОЙДЕН", Новый Цвет(47, 107, 79), Новый Цвет(145, 65, 35));
        Номер = Номер + 1;
    КонецЦикла;
    Если Итог <> Неопределено И Не ПустаяСтрока(Итог.Ошибка) Тогда
        Документ.Область(Номер, 1).Текст = "ОШИБКА";
        Документ.Область(Номер, 3, Номер, 5).Объединить();
        Документ.Область(Номер, 3).Текст = Итог.Ошибка;
        Документ.Область(Номер, 1, Номер, 5).ЦветТекста = Новый Цвет(180, 40, 40);
        Номер = Номер + 1;
    КонецЕсли;
    Ширины = СтрРазделить("14;7;39;43;32", ";");
    Для Колонка = 1 По 5 Цикл
        Документ.Область(, Колонка, , Колонка).ШиринаКолонки = Число(Ширины[Колонка - 1]);
    КонецЦикла;
    Область = Документ.Область(1, 1, Номер - 1, 5);
    Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
    Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
    Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    Документ.Область(2, 1, Номер - 1, 5).Шрифт = Новый Шрифт(, 11);
    РезультатVanessa = Документ;
КонецПроцедуры
