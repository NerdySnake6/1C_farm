&НаКлиенте
Перем ВыполняетсяЗапуск;

&НаКлиенте
Перем ИдентификаторVanessa;

&НаКлиенте
Перем СрокОжиданияVanessa;

&НаКлиенте
Перем ОбработчикVanessaПодключен;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ВыполняетсяЗапуск = Ложь;
    ОбработчикVanessaПодключен = Ложь;
    СброситьРезультатПроверок();
    Если Элементы.Найти("СлужебныеДанныеVanessa") <> Неопределено Тогда
        Элементы.СлужебныеДанныеVanessa.Скрыть();
    КонецЕсли;
    ПодключитьОбработчикОжидания("ПроверитьУходСоСтраницы", 1);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
    // При завершении приложения серверные вызовы запрещены.
    // Результат сбрасывается при следующем открытии формы.
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
    ОтключитьОбработчикОжидания("ПроверитьУходСоСтраницы");
    Если ОбработчикVanessaПодключен = Истина Тогда
        ОтключитьОбработчикОжидания("ПроверитьРезультатVanessa");
        ОбработчикVanessaПодключен = Ложь;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУходСоСтраницы() Экспорт
    // Формы, которые открывает сам тест, не должны сбрасывать текущий запуск.
    Если ВыполняетсяЗапуск Или ПустаяСтрока(ТекстПротокола) Тогда Возврат; КонецЕсли;
    Если ВводДоступен() Тогда Возврат; КонецЕсли;
    // Потеря фокуса всем приложением не означает переход на другую страницу.
    Для Каждого ОкноПриложения Из ПолучитьОкна() Цикл
        Для Каждого ФормаОкна Из ОкноПриложения.Содержимое Цикл
            Если ФормаОкна <> ЭтаФорма И ФормаОкна.ВводДоступен() Тогда
                СброситьРезультатПроверок();
                Возврат;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СброситьРезультатПроверок() Экспорт
    Успешно = Ложь;
    Пройдено = 0;
    ТекстПротокола = "";
    Элементы.Итог.Заголовок = "Готово к запуску. Результаты появятся ниже.";
    Элементы.Итог.ЦветТекста = Новый Цвет(60, 60, 60);
    ПоказатьПротоколПроверок(Неопределено);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Автотесты доступны администратору учебной базы.";
    КонецЕсли;
    Заголовок = "Автотесты: бронирование и продажа";
    АвтоЗаголовок = Ложь;
    ЦветФона = Новый Цвет(248, 246, 238);
    Подпись = Элементы.Добавить("Название", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Проверка работы фермы";
    Подпись.Ширина = 100;
    Подпись.Шрифт = Новый Шрифт(, 20, Истина);
    Подпись.ЦветТекста = Новый Цвет(47, 107, 79);
    Подпись = Элементы.Добавить("Описание", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "32 проверки учета и 9 проверок форм. Тест создает свои данные и удаляет их после выполнения.";
    Подпись.Ширина = 110;
    Подпись = Элементы.Добавить("СмыслПроверок", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Проверяем доступный товар, продажу по брони, отмену и кнопки форм. Ниже указаны действия и ожидаемые результаты.";
    Подпись.Ширина = 130;
    Подпись = Элементы.Добавить("СмыслОтказов", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Если операция запрещена, правильный отказ означает успешную проверку. Например, нельзя продать 56 л, когда свободно только 55 л.";
    Подпись.Ширина = 130;
    Команда = Команды.Добавить("ЗапуститьТесты");
    Команда.Заголовок = "Запустить 41 проверку";
    Команда.Действие = "ЗапуститьТесты";
    Кнопка = Элементы.Добавить("ЗапуститьТесты", Тип("КнопкаФормы"));
    Кнопка.ИмяКоманды = "ЗапуститьТесты";
    Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
    Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    Команда = Команды.Добавить("ЗапуститьVanessa");
    Команда.Заголовок = "Запустить Vanessa";
    Команда.Действие = "ЗапуститьVanessa";
    Кнопка = Элементы.Добавить("ЗапуститьVanessa", Тип("КнопкаФормы"));
    Кнопка.ИмяКоманды = "ЗапуститьVanessa";
    Подпись = Элементы.Добавить("ИтогVanessa", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Vanessa: 18 сценариев интерфейса в отдельной тестовой базе.";
    Подпись.Ширина = 110;
    Поле = Элементы.Добавить("ПротоколVanessa", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "РезультатVanessa";
    Поле.Заголовок = "Результаты Vanessa";
    Поле.Высота = 17;
    Поле.Ширина = 110;
    Поле.ТолькоПросмотр = Истина;
    ПоказатьТаблицуVanessa();
    Подпись = Элементы.Добавить("ГраницыПроверокVanessa", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Таблица Vanessa показывает результаты восемнадцати UI-сценариев в отдельной базе. VA01–VA03 проверяют экран встроенного набора, VA04–VA14 — операции документов, VA15–VA18 — права и отчёты. Ниже — отдельные 41 встроенная проверка.";
    Подпись.Ширина = 125;
    Подпись = Элементы.Добавить("Итог", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Готово к запуску. Результаты появятся ниже.";
    Подпись.Ширина = 100;
    Подпись.Шрифт = Новый Шрифт(, 16, Истина);
    Поле = Элементы.Добавить("Протокол", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "Результат";
    Поле.Высота = 22;
    Поле.Ширина = 110;
    Поле.ТолькоПросмотр = Истина;
    ДобавитьКонтрольОперацийVanessa();
    ПоказатьПротоколПроверок(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТесты(Команда) Экспорт
    ВыполняетсяЗапуск = Истина;
    Элементы.ЗапуститьТесты.Доступность = Ложь;
    Элементы.Итог.Заголовок = "Выполняются проверки...";
    Протокол = Новый Массив;
    Запуск = Неопределено;
    ФормаБрони = Неопределено;
    НоваяФормаБрони = Неопределено;
    ОтчетБрони = Неопределено;
    ПанельБрони = Неопределено;
    РабочийСтолБрони = Неопределено;
    Попытка
        Запуск = СервисФермы.ПодготовитьВстроенныеАвтотесты();
        СервисФермы.ВыполнитьВстроенныеПроверкиДанных(Запуск);
        ВыполнитьПроверкиФорм(Запуск, Протокол);
    Исключение
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    Если Запуск <> Неопределено Тогда
        Итог = СервисФермы.ЗавершитьВстроенныеАвтотесты(Запуск, Протокол);
    Иначе
        Итог = Новый Структура("Успешно,Пройдено,Линии", Ложь, 0, Протокол);
    КонецЕсли;
    ПоказатьРезультат(Итог);
    Элементы.ЗапуститьТесты.Доступность = Истина;
    ВыполняетсяЗапуск = Ложь;
    ЭтаФорма.Открыть();
КонецПроцедуры

&НаСервере
Процедура ПоказатьРезультат(Итог)
    Успешно = Итог.Успешно;
    Пройдено = Итог.Пройдено;
    ИтоговаяСтрока = ?(Итог.Успешно, "ПРОЙДЕНО 41 ИЗ 41", "ПРОВЕРКИ НЕ ПРОЙДЕНЫ: " + Строка(Итог.Пройдено) + " из 41");
    Элементы.Итог.Заголовок = ИтоговаяСтрока;
    Элементы.Итог.ЦветТекста = ?(Итог.Успешно, Новый Цвет(47, 107, 79), Новый Цвет(180, 40, 40));
    ТекстПротокола = ИтоговаяСтрока + Символы.ПС;
    Для Каждого Строка Из Итог.Линии Цикл
        Если Строка = "COMPLETE" Тогда Продолжить; КонецЕсли;
        ТекстПротокола = ТекстПротокола + Строка + Символы.ПС;
    КонецЦикла;
    ПоказатьПротоколПроверок(Итог);
КонецПроцедуры

&НаСервере
Процедура ДобавитьОписаниеПроверки(Описания, Код, Действие, Ожидание)
    Описания.Добавить(Новый Структура("Код,Действие,Ожидание", Код, Действие, Ожидание));
КонецПроцедуры

&НаСервере
