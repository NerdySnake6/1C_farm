&НаКлиенте
Процедура ЗапуститьАвтотесты(Команда) Экспорт
#Если ВебКлиент Тогда
    Сообщить("Для запуска автотестов откройте базу в клиенте 1С на macOS.");
#Иначе
    Система = Новый СистемнаяИнформация;
    Если Система.ТипПлатформы <> ТипПлатформы.MacOS_x86_64 Тогда
        Сообщить("Для запуска автотестов откройте базу в клиенте 1С на macOS.");
        Возврат;
    КонецЕсли;

    ПутьЗапуска = ПолучитьПутьЗапускаАвтотестов();
    Если ПутьЗапуска = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Если ПроверитьПутьЗапускаАвтотестов(ПутьЗапуска) Тогда
        ОткрытьКомандуАвтотестов(ПутьЗапуска);
    Иначе
        Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
        Диалог.Заголовок = "Выберите tests/vanessa/run.command из папки проекта";
        Диалог.Фильтр = "Команды запуска автотестов (*.command)|*.command";
        Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораКомандыАвтотестов", ЭтаФорма));
    КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКомандыАвтотестов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ПутьЗапуска = ВыбранныеФайлы[0];
    Если Не ПроверитьПутьЗапускаАвтотестов(ПутьЗапуска) Тогда
        Сообщить("Выберите файл tests/vanessa/run.command из папки проекта.");
        Возврат;
    КонецЕсли;

    Если СохранитьПутьЗапускаАвтотестов(ПутьЗапуска) Тогда
        ОткрытьКомандуАвтотестов(ПутьЗапуска);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПутьЗапускаАвтотестов(ПутьЗапуска)
#Если ВебКлиент Тогда
    Возврат Ложь;
#Иначе
    ИмяКоманды = "/tests/vanessa/run.command";
    Если ТипЗнч(ПутьЗапуска) <> Тип("Строка")
        Или Лев(ПутьЗапуска, 1) <> "/"
        Или Прав(ПутьЗапуска, СтрДлина(ИмяКоманды)) <> ИмяКоманды
        Или СтрНайти(ПутьЗапуска, """") > 0
        Или СтрНайти(ПутьЗапуска, "\") > 0
        Или СтрНайти(ПутьЗапуска, "$") > 0
        Или СтрНайти(ПутьЗапуска, Символ(96)) > 0
        Или СтрНайти(ПутьЗапуска, Символы.ПС) > 0
        Или СтрНайти(ПутьЗапуска, Символы.ВК) > 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    ФайлЗапуска = Новый Файл(ПутьЗапуска);
    Возврат ФайлЗапуска.Существует() И ФайлЗапуска.ЭтоФайл();
#КонецЕсли
КонецФункции

&НаКлиенте
Процедура ОткрытьКомандуАвтотестов(ПутьЗапуска)
#Если Не ВебКлиент Тогда
    Попытка
        ЗапуститьПриложение("/usr/bin/open -a Terminal """ + ПутьЗапуска + """");
    Исключение
        Сообщить("Не удалось открыть команду автотестов в Terminal: " + ОписаниеОшибки());
    КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПутьЗапускаАвтотестов()
    Если Не РольДоступна("ПолныеПрава") Тогда
        Возврат Неопределено;
    КонецЕсли;

    ПутьЗапуска = ХранилищеОбщихНастроек.Загрузить("VanessaAutomation", "ПутьККомандеЗапуска");
    Возврат ?(ПутьЗапуска = Неопределено, "", ПутьЗапуска);
КонецФункции

&НаСервереБезКонтекста
Функция СохранитьПутьЗапускаАвтотестов(ПутьЗапуска)
    Если Не РольДоступна("ПолныеПрава") Тогда
        Возврат Ложь;
    КонецЕсли;

    ХранилищеОбщихНастроек.Сохранить("VanessaAutomation", "ПутьККомандеЗапуска", ПутьЗапуска);
    Возврат Истина;
КонецФункции

&НаСервере
Процедура ДобавитьПоле(Имя, Путь, Заголовок, Родитель = Неопределено)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
    Команда = Команды.Добавить(Имя);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
    
    // Делаем кнопки создания документов темными, а журналы — светлыми
    Если Имя = "ОткрытьПриходы" Или Имя = "ОткрытьРасходы" Или Имя = "ОткрытьБрони" Тогда
        Кнопка.ЦветФона = Новый Цвет(230, 239, 231);
        Кнопка.ЦветТекста = Новый Цвет(32, 56, 44);
    Иначе
        Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
        Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    КонецЕсли;
КонецПроцедуры
