&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Рабочий стол фермы";
    АвтоЗаголовок = Ложь;
    ЦветФона = Новый Цвет(248, 246, 238);
    Подпись = Элементы.Добавить("НазваниеФермы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Молочная ферма Луговая";
    Подпись.Шрифт = Новый Шрифт(, 20, Истина);
    Подпись.ЦветТекста = Новый Цвет(47, 107, 79);
    Подпись = Элементы.Добавить("ОписаниеФермы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Поступление и продажа молока, творога и сметаны";
    Если РольДоступна("ПолныеПрава") Тогда
        ПроверкаСистемы = ДобавитьГруппуКоманд(Неопределено, "ПроверкаСистемы", "Проверка работы системы");
        ДобавитьКнопку("ОткрытьАвтотестыНаГлавной", "Автотесты", ПроверкаСистемы);
        Подсказка = Элементы.Добавить("КакЗапуститьАвтотесты", Тип("ДекорацияФормы"), ПроверкаСистемы);
        Подсказка.Вид = ВидДекорацииФормы.Надпись;
        Подсказка.Заголовок = "Откройте список проверок и нажмите «Запустить 41 проверку». Результат появится в этой же странице.";
        Подсказка.Ширина = 100;
    КонецЕсли;
    Разделы = Элементы.Добавить("РазделыРаботы", Тип("ГруппаФормы"));
    Разделы.Вид = ВидГруппыФормы.Страницы;
    Операции = ДобавитьВкладку(Разделы, "Операции", "Документы");
    ГруппаСправочников = ДобавитьВкладку(Разделы, "СправочныеДанные", "Продукция и цены");
    ГруппаОтчетов = ДобавитьВкладку(Разделы, "ОтчетыФермы", "Отчёты");
    Создание = ДобавитьГруппуКоманд(Операции, "СозданиеДокументов", "Создание");
    Журналы = ДобавитьГруппуКоманд(Операции, "ЖурналыДокументов", "Журналы");
    Если РольДоступна("Покупка") Или РольДоступна("ПолныеПрава") Тогда
        ДобавитьКнопку("СоздатьПриход", "Оформить приход продукции", Создание);
        ДобавитьКнопку("ОткрытьПриходы", "Журнал поступлений", Журналы);
    КонецЕсли;
    Если РольДоступна("Продажа") Или РольДоступна("ПолныеПрава") Тогда
        ДобавитьКнопку("СоздатьБронь", "Забронировать продукцию", Создание);
        ДобавитьКнопку("ОткрытьБрони", "Журнал бронирований", Журналы);
        ДобавитьКнопку("СоздатьРасход", "Продажа продукции", Создание);
        ДобавитьКнопку("ОткрытьРасходы", "Продажа продукции", Журналы);
    КонецЕсли;
    ДобавитьКнопку("ОткрытьПродукцию", "Продукция и фотографии", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьЦены", "Цены продукции", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьОстатки", "Остатки на складе", ГруппаОтчетов);
    ДобавитьКнопку("ОткрытьДоступность", "Доступность продукции (остаток, бронь, свободно)", ГруппаОтчетов);
    Если РольДоступна("Продажа") Или РольДоступна("ПолныеПрава") Тогда
        ДобавитьКнопку("ОткрытьПродажи", "Отчёт о продажах", ГруппаОтчетов);
    КонецЕсли;
    Если РольДоступна("ПолныеПрава") Тогда
        Тестирование = ДобавитьВкладку(Разделы, "ТестированиеФермы", "Тестирование");
        ДобавитьКнопку("ОткрытьАвтотесты", "Автотесты: запустить проверки", Тестирование);
    КонецЕсли;
    Подпись = Элементы.Добавить("ПорядокРаботы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Начните с карточек продукции и цен. Затем оформите приход, продажу и проверьте остатки.";
КонецПроцедуры

&НаСервере
Функция ДобавитьВкладку(Родитель, Имя, Заголовок)
    Вкладка = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
    Вкладка.Вид = ВидГруппыФормы.Страница;
    Вкладка.Заголовок = Заголовок;
    Возврат Вкладка;
КонецФункции

