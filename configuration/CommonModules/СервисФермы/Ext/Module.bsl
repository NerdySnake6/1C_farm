// Служебные операции разрешены только администратору учебной базы.
Процедура ПроверитьАдминистратора()
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Операция доступна только пользователю с полными правами.";
    КонецЕсли;
КонецПроцедуры

Функция СоздатьЭлемент(Менеджер, Наименование)
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Элемент = Менеджер.СоздатьЭлемент();
    Элемент.Наименование = Наименование;
    Элемент.Записать();
    Возврат Элемент.Ссылка;
КонецФункции

Функция ЗаполнитьПример(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Организация = СоздатьЭлемент(Справочники.Организации, "Молочная ферма Луговая");
    Склад = СоздатьЭлемент(Справочники.Склады, "Холодильный склад");
    Поставщик = СоздатьЭлемент(Справочники.Поставщики, "Кооператив Молочный край");
    Покупатель = СоздатьЭлемент(Справочники.Покупатели, "Магазин Свежие продукты");
    Имена = СтрРазделить("Молоко 3,2%;Творог 9%;Сметана 20%", ";");
    Файлы = СтрРазделить("milk.png;curd.png;cream.png", ";");
    Единицы = СтрРазделить("л;кг;кг", ";");
    Цены = Новый Массив;
    Цены.Добавить(90); Цены.Добавить(360); Цены.Добавить(280);
    Продукция = Новый Массив;
    Для Индекс = 0 По 2 Цикл
        Ссылка = СоздатьЭлемент(Справочники.Номенклатура, Имена[Индекс]);
        Элемент = Ссылка.ПолучитьОбъект();
        Элемент.ЕдиницаИзмерения = Единицы[Индекс];
        ФайлФото = Новый Файл(КаталогПроекта + "/assets/" + Файлы[Индекс]);
        Если ФайлФото.Существует() Тогда
            Элемент.Фотография = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ФайлФото.ПолноеИмя));
        КонецЕсли;
        Элемент.Записать();
        Продукция.Добавить(Ссылка);
        ЗаписьЦены = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
        ЗаписьЦены.Период = НачалоДня(ТекущаяДатаСеанса());
        ЗаписьЦены.Номенклатура = Ссылка;
        ЗаписьЦены.Цена = Цены[Индекс];
        ЗаписьЦены.Записать();
    КонецЦикла;
    Данные = Новый Структура("Организация,Склад,Поставщик,Покупатель,Продукция,Цены", Организация, Склад, Поставщик, Покупатель, Продукция, Цены);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Приход");
    Если Запрос.Выполнить().Пустой() Тогда
        Приход = НовыйДокумент("Приход", Данные, 100, 20, 15);
        Приход.Дата = Приход.Дата - 1;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Расход = НовыйДокумент("Расход", Данные, 25, 5, 3);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция НовыйДокумент(Вид, Данные, Молоко, Творог, Сметана)
    Документ = Документы[Вид].СоздатьДокумент();
    Документ.Дата = ТекущаяДатаСеанса();
    Документ.Организация = Данные.Организация;
    Документ.Склад = Данные.Склад;
    Если Вид = "Приход" Тогда
        Документ.Поставщик = Данные.Поставщик;
    Иначе
        Документ.Покупатель = Данные.Покупатель;
    КонецЕсли;
    Количества = Новый Массив;
    Количества.Добавить(Молоко); Количества.Добавить(Творог); Количества.Добавить(Сметана);
    Для Индекс = 0 По 2 Цикл
        СтрокаТовара = Документ.Товары.Добавить();
        СтрокаТовара.Номенклатура = Данные.Продукция[Индекс];
        СтрокаТовара.Количество = Количества[Индекс];
        СтрокаТовара.Цена = Данные.Цены[Индекс];
    КонецЦикла;
    Возврат Документ;
КонецФункции

Функция Остаток(Данные, Индекс)
    Запрос = Новый Запрос("ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления.ОстаткиПродукции.Остатки(, Организация = &Организация И Склад = &Склад И Номенклатура = &Продукция)");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Запрос.УстановитьПараметр("Склад", Данные.Склад);
    Запрос.УстановитьПараметр("Продукция", Данные.Продукция[Индекс]);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.КоличествоОстаток;
    КонецЕсли;
    Возврат 0;
КонецФункции

Процедура Утвердить(Условие, ИмяТеста, Протокол)
    Если Не Условие Тогда
        Протокол.Добавить("FAIL | " + ИмяТеста);
        ВызватьИсключение ИмяТеста;
    КонецЕсли;
    Протокол.Добавить("PASS | " + ИмяТеста);
КонецПроцедуры

Функция КонечнаяПричинаОшибки(Ошибка) Экспорт
    Пока Ошибка.Причина <> Неопределено Цикл Ошибка = Ошибка.Причина; КонецЦикла;
    Возврат Ошибка.Описание;
КонецФункции

Функция ПричинаСовпадает(Причина, ОжидаемаяПричина) Экспорт
    Возврат Не ПустаяСтрока(ОжидаемаяПричина)
        И Лев(Причина, СтрДлина(ОжидаемаяПричина)) = ОжидаемаяПричина;
КонецФункции

Функция ОжидаемаяПричинаОтказа(Код)
    Если Код = "B03" Или Код = "B05" Или Код = "B06" Или Код = "B09" Или Код = "B28"
        Или Код = "T06" Или Код = "T17" Или Код = "T18" Тогда
        Возврат "Недостаточно свободной продукции:";
    ИначеЕсли Код = "B10" Тогда
        Возврат "Количество не совпадает с бронью. Частичная продажа не предусмотрена.";
    ИначеЕсли Код = "B11" Или Код = "B12" Тогда
        Возврат "Организация, склад и покупатель должны совпадать с бронью.";
    ИначеЕсли Код = "B13" Тогда
        Возврат "Продажа не может быть раньше брони.";
    ИначеЕсли Код = "B15" Тогда
        Возврат "Бронь не действует. Выберите проведённую бронь.";
    ИначеЕсли Код = "B20" Тогда
        Возврат "По этой брони уже проведена продажа.";
    ИначеЕсли Код = "B21" Или Код = "B22" Тогда
        Возврат "Бронь продана. Сначала отмените проведение связанной продажи.";
    ИначеЕсли Код = "B25" Или Код = "B26" Тогда
        Возврат "Укажите продукцию, положительное количество и цену.";
    ИначеЕсли Код = "B29" Или Код = "S02" Тогда
        Возврат "Снятая бронь не может быть проведена повторно. Создайте новую бронь.";
    ИначеЕсли Код = "B31" Тогда
        Возврат "Срок действия брони истек. Укажите будущие дату и время.";
    ИначеЕсли Код = "T08" Или Код = "T09" Или Код = "T10" Тогда
        Возврат "В каждой строке укажите продукцию, положительное количество и цену.";
    ИначеЕсли Код = "T11" Тогда
        Возврат "Заполните организацию, склад и контрагента.";
    ИначеЕсли Код = "T12" Тогда
        Возврат "Добавьте продукцию в документ.";
    КонецЕсли;
    ВызватьИсключение "Не задана ожидаемая причина отказа для теста " + Код;
КонецФункции

Процедура ОжидаетсяОтказ(Документ, ИмяТеста, Протокол, Режим = Неопределено, ПричинаОжидания = "")
    Если ПустаяСтрока(ПричинаОжидания) Тогда
        ПричинаОжидания = ОжидаемаяПричинаОтказа(СтрРазделить(ИмяТеста, " ")[0]);
    КонецЕсли;
    БылОтказ = Ложь;
    Причина = "Операция неожиданно разрешена";
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Если Режим = Неопределено Тогда
            Документ.Записать(РежимЗаписиДокумента.Проведение);
        Иначе
            Документ.Записать(Режим);
        КонецЕсли;
    Исключение
        БылОтказ = Истина;
        Причина = КонечнаяПричинаОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    ОтменитьТранзакцию();
    Если Не БылОтказ Или Не ПричинаСовпадает(Причина, ПричинаОжидания) Тогда
        Утвердить(Ложь, ИмяТеста + ". Ожидалось: " + ПричинаОжидания + ". Получено: " + Причина, Протокол);
    КонецЕсли;
    Утвердить(Истина, ИмяТеста + " [Ожидаемый отказ подтвержден: " + Причина + "]", Протокол);
КонецПроцедуры

Процедура ВыполнитьПроверки(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    Попытка
        Данные = ЗаполнитьПример(КаталогПроекта);
        Утвердить(Остаток(Данные, 0) = 75, "T01 Молоко 100 - 25 = 75 л", Протокол);
        Утвердить(Остаток(Данные, 1) = 15, "T02 Творог 20 - 5 = 15 кг", Протокол);
        Утвердить(Остаток(Данные, 2) = 12, "T03 Сметана 15 - 3 = 12 кг", Протокол);
        Утвердить(УчетФермы.ПолучитьЦену(ТекущаяДатаСеанса(), Данные.Продукция[0]) = 90, "T04 Цена молока из регистра", Протокол);
        Для Каждого Продукт Из Данные.Продукция Цикл
            Утвердить(Продукт.Фотография.Получить() <> Неопределено, "T05 Фото " + Строка(Продукт), Протокол);
        КонецЦикла;
        Документ = НовыйДокумент("Расход", Данные, 76, 1, 1);
        ОжидаетсяОтказ(Документ, "T06 Продажа сверх остатка", Протокол);
        Утвердить(Остаток(Данные, 0) = 75, "T07 Остаток сохранен после отказа", Протокол);
        Документ = НовыйДокумент("Расход", Данные, 0, 1, 1);
        ОжидаетсяОтказ(Документ, "T08 Нулевое количество", Протокол);
        Документ = НовыйДокумент("Приход", Данные, -1, 1, 1);
        ОжидаетсяОтказ(Документ, "T09 Отрицательное количество", Протокол);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        Документ.Товары[0].Цена = 0;
        ОжидаетсяОтказ(Документ, "T10 Нулевая цена", Протокол);
        Документ = НовыйДокумент("Приход", Данные, 1, 1, 1);
        Документ.Склад = Справочники.Склады.ПустаяСсылка();
        ОжидаетсяОтказ(Документ, "T11 Не заполнен склад", Протокол);
        Документ = НовыйДокумент("Приход", Данные, 1, 1, 1);
        Документ.Товары.Очистить();
        ОжидаетсяОтказ(Документ, "T12 Пустая табличная часть", Протокол);
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        Документ.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 74, "T13 Движение продажи", Протокол);
        Утвердить(Документ.Товары[0].Сумма = 90, "T14 Расчет суммы", Протокол);
        Документ.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 74, "T15 Перепроведение без дублей", Протокол);
        Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75, "T16 Отмена продажи возвращает остаток", Протокол);
        ОтменитьТранзакцию();
        Выборка = Документы.Приход.Выбрать();
        Выборка.Следующий();
        ОжидаетсяОтказ(Выборка.ПолучитьОбъект(), "T17 Запрет отмены прихода при проданной продукции", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        СтрокаТовара = Документ.Товары.Добавить();
        СтрокаТовара.Номенклатура = Данные.Продукция[0];
        СтрокаТовара.Количество = 75;
        СтрокаТовара.Цена = 90;
        ОжидаетсяОтказ(Документ, "T18 Повторяющиеся строки учитываются суммарно", Протокол);
        Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Т.Сумма) КАК Сумма ИЗ Документ.Расход.Товары КАК Т ГДЕ Т.Ссылка.Проведен");
        Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
        Утвердить(Выборка.Сумма = 4890, "T19 Сумма продаж 4890 руб", Протокол);
        Протокол.Добавить("COMPLETE");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    ФайлПротокола = Новый ЗаписьТекста(КаталогПроекта + "/.build/runtime-tests.txt", КодировкаТекста.UTF8);
    Для Каждого СтрокаПротокола Из Протокол Цикл
        ФайлПротокола.ЗаписатьСтроку(СтрокаПротокола);
    КонецЦикла;
    ФайлПротокола.Закрыть();
КонецПроцедуры

Функция ПолучитьМолоко() Экспорт
    ПроверитьАдминистратора();
    Возврат Справочники.Номенклатура.НайтиПоНаименованию("Молоко 3,2%", Истина);
КонецФункции

Процедура СоздатьУчебныхПользователей() Экспорт
    ПроверитьАдминистратора();
    Для Каждого ИмяРоли Из СтрРазделить("ПолныеПрава;Покупка;Продажа", ";") Цикл
        ИмяПользователя = ?(ИмяРоли = "ПолныеПрава", "Администратор", ИмяРоли);
        Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
        Если Пользователь = Неопределено Тогда
            Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
            Пользователь.Имя = ИмяПользователя;
            Пользователь.ПолноеИмя = ИмяПользователя;
            Пользователь.АутентификацияСтандартная = Истина;
            Пользователь.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
            Пользователь.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПроверитьРабочуюРоль() Экспорт
    Результат = Новый Массив;
    ЭтоПокупка = РольДоступна("Покупка");
    ЭтоПродажа = РольДоступна("Продажа");
    Утвердить(ЭтоПокупка <> ЭтоПродажа, "R01 Назначена одна рабочая роль", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Приход) = ЭтоПокупка, "R02 Право проведения прихода", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Расход) = ЭтоПродажа, "R03 Право проведения расхода", Результат);
    Утвердить(ПравоДоступа("Изменение", Метаданные.РегистрыСведений.Цены) = ЭтоПокупка, "R04 Изменение цен", Результат);
    Утвердить(Не ПравоДоступа("Администрирование", Метаданные), "R05 Нет административных прав", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Бронирование) = ЭтоПродажа, "R08 Проведение брони по роли", Результат);
    Утвердить(ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.РезервыПродукции), "R09 Чтение резервов доступно", Результат);
    Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции


Функция ПолучитьПустойСклад() Экспорт
    ПроверитьАдминистратора();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Ссылка = СоздатьЭлемент(Справочники.Склады, "Тестовый пустой склад");
    ОтменитьТранзакцию();
    Возврат Ссылка;
КонецФункции

Функция ТестоваяБронь(Данные, Количество)
    Бронь = Документы.Бронирование.СоздатьДокумент();
    Бронь.Дата = ТекущаяДатаСеанса();
    Бронь.СрокБрони = Бронь.Дата + 259200;
    Бронь.Организация = Данные.Организация;
    Бронь.Склад = Данные.Склад;
    Бронь.Покупатель = Данные.Покупатель;
    Товар = Бронь.Товары.Добавить();
    Товар.Номенклатура = Данные.Продукция[0];
    Товар.Количество = Количество;
    Товар.Цена = 90;
    Возврат Бронь;
КонецФункции

Функция ТестоваяПродажаБрони(Бронь)
    Продажа = Документы.Расход.СоздатьДокумент();
    Продажа.Дата = Бронь.Дата + 1;
    Продажа.Организация = Бронь.Организация;
    Продажа.Склад = Бронь.Склад;
    Продажа.Покупатель = Бронь.Покупатель;
    Продажа.Бронирование = Бронь.Ссылка;
    Для Каждого СтрокаБрони Из Бронь.Товары Цикл
        Товар = Продажа.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, СтрокаБрони);
    КонецЦикла;
    Возврат Продажа;
КонецФункции

Функция ТестовыйРезерв(Данные)
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество
    |ИЗ РегистрНакопления.РезервыПродукции.Остатки(, Организация = &Организация И Склад = &Склад)");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Запрос.УстановитьПараметр("Склад", Данные.Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьБронирование(КаталогПроекта, ДанныеИспытаний = Неопределено) Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    УдалитьДокументы = Новый Массив;
    Попытка
        Если ДанныеИспытаний = Неопределено Тогда
            Данные = ЗаполнитьПример(КаталогПроекта);
            Данные.Организация = СоздатьЭлемент(Справочники.Организации, "Испытания бронирования");
            Данные.Склад = СоздатьЭлемент(Справочники.Склады, "Склад испытаний бронирования");
        Иначе
            Данные = ДанныеИспытаний;
        КонецЕсли;
        Приход = НовыйДокумент("Приход", Данные, 75, 1, 1);
        Приход.Дата = Приход.Дата - 2;
        Пока Приход.Товары.Количество() > 1 Цикл
            Приход.Товары.Удалить(Приход.Товары[1]);
        КонецЦикла;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Приход.Ссылка);
        Бронь = ТестоваяБронь(Данные, 20);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B01 Бронь 20: склад 75, резерв 20, свободно 55", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(ТестовыйРезерв(Данные) = 20, "B02 Перепроведение брони без дублей", Протокол);
        Продажа = ТестоваяПродажаБрони(Бронь);
        Продажа.Бронирование = Документы.Бронирование.ПустаяСсылка();
        Продажа.Товары[0].Количество = 56;
        ОжидаетсяОтказ(Продажа, "B03 Обычная продажа 56 при свободных 55 отклонена", Протокол);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B04 Неуспешная продажа не меняет остатки", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 56), "B05 Вторая бронь сверх свободного остатка отклонена", Протокол);
        ОшибкаБрони = ТестоваяБронь(Данные, 11);
        Товар = ОшибкаБрони.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, ОшибкаБрони.Товары[0]);
        Товар.Количество = 45;
        ОжидаетсяОтказ(ОшибкаБрони, "B06 Повторяющиеся строки брони проверены суммарно", Протокол);
        Продажа.Товары[0].Количество = 55;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Продажа.Ссылка);
        Утвердить(Остаток(Данные, 0) = 20 И ТестовыйРезерв(Данные) = 20, "B07 Продажа ровно свободного остатка разрешена", Протокол);
        Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B08 Отмена обычной продажи сохраняет бронь", Протокол);
        ОжидаетсяОтказ(Приход, "B09 Отмена прихода под действующей бронью запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Товары[0].Количество = 19;
        ОжидаетсяОтказ(ОшибкаПродажи, "B10 Частичная продажа брони отклонена", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        Если Данные.Свойство("ДругойПокупатель") Тогда
            ОшибкаПродажи.Покупатель = Данные.ДругойПокупатель;
        Иначе
            ОшибкаПродажи.Покупатель = СоздатьЭлемент(Справочники.Покупатели, "Другой покупатель испытаний");
        КонецЕсли;
        ОжидаетсяОтказ(ОшибкаПродажи, "B11 Другой покупатель по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        Если Данные.Свойство("ДругойСклад") Тогда
            ОшибкаПродажи.Склад = Данные.ДругойСклад;
        Иначе
            ОшибкаПродажи.Склад = Справочники.Склады.НайтиПоНаименованию("Холодильный склад", Истина);
        КонецЕсли;
        ОжидаетсяОтказ(ОшибкаПродажи, "B12 Другой склад по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Дата = Бронь.Дата - 1;
        ОжидаетсяОтказ(ОшибкаПродажи, "B13 Продажа раньше брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B14 Отмена брони: свободно снова 75", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B15 Продажа по отмененной брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(ТестовыйРезерв(Данные) = 0, "B16 Повторная отмена не удваивает возврат", Протокол);
        ОжидаетсяОтказ(Бронь, "B29 Повторное проведение снятой вручную брони запрещено", Протокол);
        Утвердить(ТестовыйРезерв(Данные) = 0
            И Бронь.Ссылка.Статус = Перечисления.СтатусыБрони.СнятаВручную,
            "B30 Отказ сохраняет статус и нулевой резерв", Протокол);

        ОшибкаБрони = ТестоваяБронь(Данные, 20);
        ОшибкаБрони.Дата = Приход.Дата - 3600;
        ОшибкаБрони.СрокБрони = ТекущаяДатаСеанса() - 1;
        ОжидаетсяОтказ(ОшибкаБрони, "B31 Проведение с истекшим сроком запрещено", Протокол);
        Утвердить(ТестовыйРезерв(Данные) = 0, "B32 Истекшая бронь не создает резерв", Протокол);

        Бронь = ТестоваяБронь(Данные, 20);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        ПродажаБрони = ТестоваяПродажаБрони(Бронь);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(ПродажаБрони.Ссылка);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B17 Продажа брони: склад 55, резерв 0, свободно 55", Протокол);
        Утвердить(УчетФермы.СостояниеБрони(Бронь.Ссылка) = "Продано", "B18 Состояние брони Продано", Протокол);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B19 Перепроведение продажи без повторного списания", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B20 Повторная продажа одной брони отклонена", Протокол);
        ОжидаетсяОтказ(Бронь, "B21 Отмена проданной брони запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        Бронь.Товары[0].Количество = 21;
        ОжидаетсяОтказ(Бронь, "B22 Изменение проданной брони запрещено", Протокол);
        Бронь = Бронь.Ссылка.ПолучитьОбъект();
        ПродажаБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B23 Отмена продажи возвращает товар в резерв", Протокол);
        Бронь = Бронь.Ссылка.ПолучитьОбъект();
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B24 Последующая отмена брони освобождает товар", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 0), "B25 Бронь с нулевым количеством отклонена", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, -1), "B26 Бронь с отрицательным количеством отклонена", Протокол);
        Бронь = ТестоваяБронь(Данные, 75);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(ТестовыйРезерв(Данные) = 75, "B27 Весь остаток может быть забронирован", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 1), "B28 Бронь при нулевом свободном остатке отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Протокол.Добавить("COMPLETE");
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    // Удаляем только документы, созданные этой процедурой, в обратном порядке.
    Индекс = УдалитьДокументы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Попытка
            Документ = УдалитьДокументы[Индекс].ПолучитьОбъект();
            Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
            Документ.Удалить();
        Исключение
            Протокол.Добавить("ERROR | Очистка: " + ОписаниеОшибки());
        КонецПопытки;
        Индекс = Индекс - 1;
    КонецЦикла;
    ФайлПротокола = Новый ЗаписьТекста(КаталогПроекта + "/.build/reservation-tests.txt", КодировкаТекста.UTF8);
    Для Каждого СтрокаПротокола Из Протокол Цикл ФайлПротокола.ЗаписатьСтроку(СтрокаПротокола); КонецЦикла;
    ФайлПротокола.Закрыть();
КонецПроцедуры

Функция ПодготовитьПроверкуФормыБрони(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Данные = ЗаполнитьПример(КаталогПроекта);
    Бронь = ТестоваяБронь(Данные, 5);
    Бронь.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Бронь.Ссылка;
КонецФункции

Функция СостояниеБрониДляТеста(Бронь) Экспорт
    ПроверитьАдминистратора();
    Возврат УчетФермы.СостояниеБрони(Бронь);
КонецФункции

Процедура ОтменитьПродажуТестаБрони(Бронь, Удалять = Ложь) Экспорт
    ПроверитьАдминистратора();
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Бронирование = &Бронь");
    Запрос.УстановитьПараметр("Бронь", Бронь);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Продажа = Выборка.Ссылка.ПолучитьОбъект();
        Если Продажа.Проведен Тогда Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
        Если Удалять Тогда Продажа.Удалить(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗавершитьПроверкуФормыБрони(Бронь) Экспорт
    ПроверитьАдминистратора();
    ОтменитьПродажуТестаБрони(Бронь, Истина);
    Документ = Бронь.ПолучитьОбъект();
    Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
    Документ.Удалить();
КонецПроцедуры


Процедура НастроитьРасписаниеБрони() Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда
        Возврат;
    КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.СнятьПросроченныеБрони);
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор) Цикл
        Расписание = Задание.Расписание;
        Если Задание.Использование И Расписание.ПериодПовтораДней = 0
            И Расписание.ПериодПовтораВТечениеДня = 0 Тогда
            Расписание.ПериодПовтораДней = 1;
            Расписание.ПериодПовтораВТечениеДня = 60;
            Задание.Расписание = Расписание;
            Если Не ЗначениеЗаполнено(Задание.ИмяПользователя) Тогда
                Задание.ИмяПользователя = Пользователь.Имя;
            КонецЕсли;
            Задание.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


Функция ПодготовитьПроверкуРасписания(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    НастроитьРасписаниеБрони();
    Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.СнятьПросроченныеБрони);
    Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Если Задания.Количество() <> 1 Или Не Задания[0].Использование
        Или Задания[0].Расписание.ПериодПовтораВТечениеДня <> 60
        Или Не ЗначениеЗаполнено(Задания[0].ИмяПользователя) Тогда
        ВызватьИсключение "Не настроены интервал или пользователь задания автоснятия.";
    КонецЕсли;

    Данные = ЗаполнитьПример(КаталогПроекта);
    ИсходныйРезерв = ТестовыйРезерв(Данные);
    Срочная = ТестоваяБронь(Данные, 5);
    Срочная.СрокБрони = Срочная.Дата + 8;
    Срочная.Записать(РежимЗаписиДокумента.Проведение);
    Длительная = ТестоваяБронь(Данные, 3);
    Длительная.Записать(РежимЗаписиДокумента.Проведение);
    Если ТестовыйРезерв(Данные) <> ИсходныйРезерв + 8 Тогда
        ВызватьИсключение "Начальный резерв на 8 л не подтверждён.";
    КонецЕсли;
    Возврат Новый Структура("Срочная,Длительная,ИсходныйРезерв",
        Срочная.Ссылка, Длительная.Ссылка, ИсходныйРезерв);
КонецФункции

Функция ПроверитьРезультатРасписания(Проверка) Экспорт
    ПроверитьАдминистратора();
    Если Проверка.Срочная.Статус <> Перечисления.СтатусыБрони.СнятаАвтоматически Тогда
        Возврат "";
    КонецЕсли;
    Данные = Новый Структура("Организация,Склад",
        Проверка.Срочная.Организация, Проверка.Срочная.Склад);
    Протокол = Новый Массив;
    Утвердить(Не Проверка.Срочная.Проведен И Проверка.Длительная.Проведен
        И ТестовыйРезерв(Данные) = Проверка.ИсходныйРезерв + 3,
        "S01 Планировщик с интервалом 60 секунд снял 5 л и оставил 3 л", Протокол);
    Срочная = Проверка.Срочная.ПолучитьОбъект();
    Срочная.СрокБрони = ТекущаяДатаСеанса() + 3600;
    ОжидаетсяОтказ(Срочная, "S02 Автоматически снятая бронь не перепроводится", Протокол);
    Утвердить(Срочная.Ссылка.Статус = Перечисления.СтатусыБрони.СнятаАвтоматически
        И ТестовыйРезерв(Данные) = Проверка.ИсходныйРезерв + 3,
        "S03 Отказ сохранил статус и резерв", Протокол);
    Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.СнятьПросроченныеБрони);
    Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Утвердить(ЗначениеЗаполнено(Срочная.Ссылка.ДатаСнятия)
        И Срочная.Ссылка.ДатаСнятия >= Проверка.Срочная.СрокБрони
        И Срочная.Ссылка.АвторСнятия = Задания[0].ИмяПользователя
        И Срочная.Ссылка.ПричинаСнятия = "Истёк срок действия",
        "S04 Сохранены дата, автор задания и причина автоснятия", Протокол);
    Протокол.Добавить("COMPLETE");
    Возврат СтрСоединить(Протокол, Символы.ПС);
КонецФункции

// Автотесты используют собственные объекты и не заполняют рабочие справочники.
Функция ПроверитьЗащитуОтЛожногоУспеха() Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    ОтказТеста = Ложь;
    // Объект без метода Записать вызывает техническую, а не бизнес-ошибку.
    Попытка
        ОжидаетсяОтказ(Новый Структура, "B03 Контроль посторонней ошибки", Протокол);
    Исключение
        ОтказТеста = Истина;
    КонецПопытки;
    Если Не ОтказТеста Или Протокол.Количество() <> 1 Или Лев(Протокол[0], 7) <> "FAIL | " Тогда
        ВызватьИсключение "Посторонняя техническая ошибка ошибочно принята за ожидаемый отказ";
    КонецЕсли;
    Если ПричинаСовпадает("Операция неожиданно разрешена", "Недостаточно свободной продукции:") Тогда
        ВызватьИсключение "Проверка причины отказа принимает успешную операцию";
    КонецЕсли;
    Возврат "PASS | Посторонняя техническая ошибка отклонена: " + Протокол[0];
КонецФункции

Функция НовыйОбъектАвтотестов(Менеджер, Имя, Ссылки)
    Объект = Менеджер.СоздатьЭлемент();
    Объект.Наименование = Имя;
    Объект.Записать();
    Ссылки.Добавить(Объект.Ссылка);
    Возврат Объект.Ссылка;
КонецФункции

Функция ПодготовитьВстроенныеАвтотесты() Экспорт
    ПроверитьАдминистратора();
    Каталог = ПолучитьИмяВременногоФайла();
    СоздатьКаталог(Каталог + "/.build");
    Ссылки = Новый Массив;
    Префикс = "Автотест " + Лев(Строка(Новый УникальныйИдентификатор), 8) + " ";
    Данные = Новый Структура;
    Данные.Вставить("Организация", НовыйОбъектАвтотестов(Справочники.Организации, Префикс + "Ферма", Ссылки));
    Данные.Вставить("Склад", НовыйОбъектАвтотестов(Справочники.Склады, Префикс + "Склад", Ссылки));
    Данные.Вставить("ДругойСклад", НовыйОбъектАвтотестов(Справочники.Склады, Префикс + "Другой склад", Ссылки));
    Данные.Вставить("Поставщик", НовыйОбъектАвтотестов(Справочники.Поставщики, Префикс + "Поставщик", Ссылки));
    Данные.Вставить("Покупатель", НовыйОбъектАвтотестов(Справочники.Покупатели, Префикс + "Покупатель", Ссылки));
    Данные.Вставить("ДругойПокупатель", НовыйОбъектАвтотестов(Справочники.Покупатели, Префикс + "Другой покупатель", Ссылки));
    Продукция = Новый Массив;
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Молоко", Ссылки));
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Творог", Ссылки));
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Сметана", Ссылки));
    Цены = Новый Массив;
    Цены.Добавить(90);
    Цены.Добавить(360);
    Цены.Добавить(280);
    Данные.Вставить("Продукция", Продукция);
    Данные.Вставить("Цены", Цены);
    Возврат Новый Структура("Каталог,Данные,Ссылки", Каталог, Данные, Ссылки);
КонецФункции

Процедура ВыполнитьВстроенныеПроверкиДанных(Запуск) Экспорт
    ПроверитьАдминистратора();
    ПроверитьБронирование(Запуск.Каталог, Запуск.Данные);
КонецПроцедуры

Функция БроньВстроенногоТеста(Запуск) Экспорт
    ПроверитьАдминистратора();
    Приход = Документы.Приход.СоздатьДокумент();
    Приход.Дата = ТекущаяДатаСеанса();
    Приход.Организация = Запуск.Данные.Организация;
    Приход.Склад = Запуск.Данные.Склад;
    Приход.Поставщик = Запуск.Данные.Поставщик;
    Строка = Приход.Товары.Добавить();
    Строка.Номенклатура = Запуск.Данные.Продукция[0];
    Строка.Количество = 75;
    Строка.Цена = 90;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Бронь = ТестоваяБронь(Запуск.Данные, 5);
    Бронь.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Бронь.Ссылка;
КонецФункции

Функция ПродажиВстроенногоТеста(Запуск) Экспорт
    ПроверитьАдминистратора();
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Организация = &Организация");
    Запрос.УстановитьПараметр("Организация", Запуск.Данные.Организация);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

Процедура ОчиститьВстроенныеАвтотесты(Запуск, Протокол) Экспорт
    ПроверитьАдминистратора();
    Для Каждого Вид Из СтрРазделить("Расход;Бронирование;Приход", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ." + Вид + " ГДЕ Организация = &Организация");
        Запрос.УстановитьПараметр("Организация", Запуск.Данные.Организация);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Попытка
                Документ = Выборка.Ссылка.ПолучитьОбъект();
                Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
                Документ.Удалить();
            Исключение
                Протокол.Добавить("ERROR | Очистка документов: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
    КонецЦикла;
    Индекс = Запуск.Ссылки.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Попытка
            Запуск.Ссылки[Индекс].ПолучитьОбъект().Удалить();
        Исключение
            Протокол.Добавить("ERROR | Очистка справочников: " + ОписаниеОшибки());
        КонецПопытки;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

Функция ЗавершитьВстроенныеАвтотесты(Запуск, ПротоколФорм) Экспорт
    ПроверитьАдминистратора();
    Линии = Новый Массив;
    Попытка
        Чтение = Новый ЧтениеТекста(Запуск.Каталог + "/.build/reservation-tests.txt", КодировкаТекста.UTF8);
        Строка = Чтение.ПрочитатьСтроку();
        Пока Строка <> Неопределено Цикл
            Линии.Добавить(Строка);
            Строка = Чтение.ПрочитатьСтроку();
        КонецЦикла;
        Чтение.Закрыть();
    Исключение
        Линии.Добавить("ERROR | Протокол бизнес-логики: " + ОписаниеОшибки());
    КонецПопытки;
    Для Каждого Строка Из ПротоколФорм Цикл Линии.Добавить(Строка); КонецЦикла;
    ОчиститьВстроенныеАвтотесты(Запуск, Линии);
    Ожидаемые = Новый Соответствие;
    Для Индекс = 1 По 32 Цикл Ожидаемые.Вставить("B" + Прав("0" + Строка(Индекс), 2), 0); КонецЦикла;
    Для Индекс = 1 По 9 Цикл Ожидаемые.Вставить("BF" + Прав("0" + Строка(Индекс), 2), 0); КонецЦикла;
    Успешно = Истина;
    Завершено = 0;
    Пройдено = 0;
    Для Каждого Строка Из Линии Цикл
        Если Лев(Строка, 7) = "PASS | " Тогда
            Код = СтрРазделить(Сред(Строка, 8), " ")[0];
            Счетчик = Ожидаемые.Получить(Код);
            Если Счетчик = Неопределено Тогда
                Успешно = Ложь;
            Иначе
                Ожидаемые.Вставить(Код, Счетчик + 1);
                Пройдено = Пройдено + 1;
            КонецЕсли;
        ИначеЕсли Строка = "COMPLETE" Тогда
            Завершено = Завершено + 1;
        Иначе
            Успешно = Ложь;
        КонецЕсли;
    КонецЦикла;
    Для Каждого Пара Из Ожидаемые Цикл
        Если Пара.Значение <> 1 Тогда
            Успешно = Ложь;
            Линии.Добавить("ERROR | Неполная проверка " + Пара.Ключ);
        КонецЕсли;
    КонецЦикла;
    Успешно = Успешно И Пройдено = 41 И Завершено = 2;
    Попытка УдалитьФайлы(Запуск.Каталог); Исключение
        Успешно = Ложь;
        Линии.Добавить("ERROR | Временный каталог: " + ОписаниеОшибки());
    КонецПопытки;
    Возврат Новый Структура("Успешно,Пройдено,Линии", Успешно, Пройдено, Линии);
КонецФункции

Функция СнимокДанныхДляАвтотестов() Экспорт
    ПроверитьАдминистратора();
    Снимок = Новый Массив;
    Для Каждого Имя Из СтрРазделить("Организации;Склады;Поставщики;Покупатели;Номенклатура", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ Справочник." + Имя + " УПОРЯДОЧИТЬ ПО Ссылка");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("Приход;Расход;Бронирование", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ Документ." + Имя + " УПОРЯДОЧИТЬ ПО Ссылка");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("ОстаткиПродукции;РезервыПродукции", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрНакопления." + Имя + " УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.Цены УПОРЯДОЧИТЬ ПО Период, Номенклатура");
    Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    Возврат ЗначениеВСтрокуВнутр(Снимок);
КонецФункции


// Данные и контроль прямых UI-сценариев. Только явно помеченная отдельная база.
Функция КаталогБазыДляVanessa()
    ПроверитьАдминистратора();
    Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";") Цикл
        Часть = СокрЛП(Часть);
        Если ВРег(Лев(Часть, 5)) = "FILE=" Тогда
            Возврат СтрЗаменить(Сред(Часть, 6), """", "");
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "Прямые сценарии Vanessa поддерживают отдельную файловую базу.";
КонецФункции

Процедура ПроверитьМаркерБазыVanessa(Каталог)
    База = КаталогБазыДляVanessa();
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Каталог + "/vanessa-test-base.json");
    Попытка
        Маркер = ПрочитатьJSON(Чтение);
    Исключение
        Чтение.Закрыть();
        ВызватьИсключение;
    КонецПопытки;
    Чтение.Закрыть();
    Если Маркер.kind <> "farm-vanessa-disposable-v1"
        Или НРег(СтрЗаменить(Маркер.base, "/", "\")) <> НРег(СтрЗаменить(База, "/", "\")) Тогда
        ВызватьИсключение "Маркер Vanessa не соответствует текущей тестовой базе.";
    КонецЕсли;
КонецПроцедуры

Функция ЧерновикДокументаVanessa(Вид, Данные, Количество)
    Если Вид = "Бронирование" Тогда
        Документ = ТестоваяБронь(Данные, Количество);
    Иначе
        Документ = Документы[Вид].СоздатьДокумент();
        Документ.Дата = ТекущаяДатаСеанса();
        Документ.Организация = Данные.Организация;
        Документ.Склад = Данные.Склад;
        Если Вид = "Приход" Тогда
            Документ.Поставщик = Данные.Поставщик;
        Иначе
            Документ.Покупатель = Данные.Покупатель;
        КонецЕсли;
        Товар = Документ.Товары.Добавить();
        Товар.Номенклатура = Данные.Продукция[0];
        Товар.Количество = Количество;
        Товар.Цена = 90;
    КонецЕсли;
    Документ.Записать();
    Возврат Документ.Ссылка;
КонецФункции

Процедура ПодготовитьПрямыеСценарииVanessa(Каталог) Экспорт
    ПроверитьМаркерБазыVanessa(Каталог);
    ПутьФикстур = КаталогБазыДляVanessa() + "/farm-vanessa-fixtures.bin";
    ФайлФикстур = Новый Файл(ПутьФикстур);
    Если ФайлФикстур.Существует() Тогда
        ВызватьИсключение "Повторная подготовка фикстур запрещена. Создайте новую базу.";
    КонецЕсли;
    Пакеты = Новый Структура;
    Пакеты.Вставить("СнимокДо", СнимокДанныхДляАвтотестов());
    Переменные = Новый Структура;
    Для Каждого Код Из СтрРазделить("VA04;VA05;VA06;VA07;VA08;VA09;VA10;VA11;VA12;VA13;VA14;VA15;VA16;VA17;VA18", ";") Цикл
        Запуск = ПодготовитьВстроенныеАвтотесты();
        Пакет = Новый Структура("Запуск", Запуск);
        Пакет.Вставить("Приход", ЧерновикДокументаVanessa("Приход", Запуск.Данные, 1));
        Пакет.Вставить("Бронь", ЧерновикДокументаVanessa("Бронирование", Запуск.Данные, 1));
        Пакет.Вставить("Продажа", ЧерновикДокументаVanessa("Расход", Запуск.Данные, 56));
        Если Код = "VA09" Тогда
            Пакет.Вставить("НоваяБронь", ЧерновикДокументаVanessa("Бронирование", Запуск.Данные, 56));
            Переменные.Вставить(Код + "НоваяБронь", ПолучитьНавигационнуюСсылку(Пакет.НоваяБронь));
        КонецЕсли;
        Пакеты.Вставить(Код, Пакет);
        ЗначениеВФайл(ПутьФикстур, Пакеты);
        Если Код <> "VA04" И Код <> "VA05" И Код <> "VA15" Тогда
            Приход = Пакет.Приход.ПолучитьОбъект();
            Приход.Товары[0].Количество = 75;
            Приход.Записать(РежимЗаписиДокумента.Проведение);
            Бронь = Пакет.Бронь.ПолучитьОбъект();
            Бронь.Товары[0].Количество = 20;
            Если Код = "VA14" Тогда
                Бронь.Дата = НачалоДня(ТекущаяДатаСеанса()) - 86400;
                Бронь.СрокБрони = Бронь.Дата + 3600;
                Бронь.Записать();
            Иначе
                Бронь.Записать(РежимЗаписиДокумента.Проведение);
            КонецЕсли;
            Если Код = "VA11" Тогда
                ВтораяПродажа = Пакет.Продажа.ПолучитьОбъект();
                ВтораяПродажа.Бронирование = Пакет.Бронь;
                ВтораяПродажа.Дата = Бронь.Дата + 1;
                ВтораяПродажа.Товары[0].Количество = 20;
                ВтораяПродажа.Записать();
            КонецЕсли;
        КонецЕсли;
        Переменные.Вставить(Код + "Организация", Строка(Запуск.Данные.Организация));
        Переменные.Вставить(Код + "Склад", Строка(Запуск.Данные.Склад));
        Переменные.Вставить(Код + "Приход", ПолучитьНавигационнуюСсылку(Пакет.Приход));
        Переменные.Вставить(Код + "Бронь", ПолучитьНавигационнуюСсылку(Пакет.Бронь));
        Переменные.Вставить(Код + "Расход", ПолучитьНавигационнуюСсылку(Пакет.Продажа));
        Переменные.Вставить(Код + "Продукция", Строка(Запуск.Данные.Продукция[0]));
    КонецЦикла;
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Каталог + "/fixtures.json");
    ЗаписатьJSON(Запись, Переменные);
    Запись.Закрыть();
КонецПроцедуры

Функция КонтрольПрямогоСценарияVanessa(Код) Экспорт
    База = КаталогБазыДляVanessa();
    Пакеты = ЗначениеИзФайла(База + "/farm-vanessa-fixtures.bin");
    Если Не Пакеты.Свойство(Код) Или Код = "СнимокДо" Тогда
        ВызватьИсключение "Неизвестный код прямого сценария Vanessa.";
    КонецЕсли;
    Пакет = Пакеты[Код];
    Данные = Пакет.Запуск.Данные;
    НаСкладе = Остаток(Данные, 0);
    Резерв = ТестовыйРезерв(Данные);
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.Расход
    |ГДЕ Организация = &Организация И Проведен");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Новый Структура("Остаток,Резерв,Доступно,Продаж,ПриходПроведен,БроньПроведена,СостояниеБрони",
        НаСкладе, Резерв, НаСкладе - Резерв, Выборка.Количество, Пакет.Приход.Проведен,
        Пакет.Бронь.Проведен, СостояниеБрониДляТеста(Пакет.Бронь));
КонецФункции

Процедура ОчиститьПрямыеСценарииVanessa(Каталог) Экспорт
    ПроверитьМаркерБазыVanessa(Каталог);
    Путь = КаталогБазыДляVanessa() + "/farm-vanessa-fixtures.bin";
    Пакеты = ЗначениеИзФайла(Путь);
    Протокол = Новый Массив;
    Для Каждого Код Из СтрРазделить("VA04;VA05;VA06;VA07;VA08;VA09;VA10;VA11;VA12;VA13;VA14;VA15;VA16;VA17;VA18", ";") Цикл
        Пакет = Неопределено;
        Если Не Пакеты.Свойство(Код, Пакет) Тогда Продолжить; КонецЕсли;
        ОчиститьВстроенныеАвтотесты(Пакет.Запуск, Протокол);
        Попытка
            УдалитьФайлы(Пакет.Запуск.Каталог);
        Исключение
            Протокол.Добавить("ERROR | Временный каталог: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
    Если Протокол.Количество() > 0 Тогда
        ВызватьИсключение СтрСоединить(Протокол, Символы.ПС);
    КонецЕсли;
    Если СнимокДанныхДляАвтотестов() <> Пакеты.СнимокДо Тогда
        ВызватьИсключение "Данные базы после прямых сценариев не совпали с исходным снимком.";
    КонецЕсли;
    УдалитьФайлы(Путь);
    Запись = Новый ЗаписьТекста(Каталог + "/cleanup.txt", КодировкаТекста.UTF8);
    Запись.ЗаписатьСтроку("CLEAN");
    Запись.Закрыть();
КонецПроцедуры

Функция ДоступенКонтрольПрямыхСценариевVanessa() Экспорт
    Если Не РольДоступна("ПолныеПрава") Или СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Фикстуры = Новый Файл(КаталогБазыДляVanessa() + "/farm-vanessa-fixtures.bin");
    Возврат Фикстуры.Существует();
КонецФункции
