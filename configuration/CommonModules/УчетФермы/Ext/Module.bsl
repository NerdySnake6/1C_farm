Процедура ЗаблокироватьУчет() Экспорт
    // Общий порядок блокировок для проведения и отмены всех складских операций.
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрНакопления.ОстаткиПродукции");
    Блокировка.Добавить("РегистрНакопления.РезервыПродукции");
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура СнятьПросроченныеБрони() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Бронирование
    |ГДЕ Проведен И НЕ ПометкаУдаления И СрокБрони <> ДАТАВРЕМЯ(1, 1, 1)
    |И СрокБрони < &ТекущееВремя
    |И НЕ Ссылка В (ВЫБРАТЬ РАЗЛИЧНЫЕ Бронирование ИЗ Документ.Расход
    |ГДЕ Проведен И Бронирование <> ЗНАЧЕНИЕ(Документ.Расход.ПустаяСсылка))");
    Запрос.УстановитьПараметр("ТекущееВремя", ТекущаяДатаСеанса());
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Попытка
            Бронь = Выборка.Ссылка.ПолучитьОбъект();
            Если Бронь <> Неопределено И Бронь.Проведен Тогда
                Бронь.ДополнительныеСвойства.Вставить("АвтоСнятие", Истина);
                Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
            КонецЕсли;
        Исключение
            ЗаписьЖурналаРегистрации("Бронирование.СнятиеПросроченных",
                УровеньЖурналаРегистрации.Ошибка,, Выборка.Ссылка, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция ЕстьПродажаПоБрони(Бронь, ИсключитьПродажу = Неопределено) Экспорт
    Если Не ЗначениеЗаполнено(Бронь) Тогда Возврат Ложь; КонецЕсли;
    Если ИсключитьПродажу = Неопределено Тогда
        ИсключитьПродажу = Документы.Расход.ПустаяСсылка();
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Расход
    |ГДЕ Проведен И Бронирование = &Бронь И Ссылка <> &Исключить");
    Запрос.УстановитьПараметр("Бронь", Бронь);
    Запрос.УстановитьПараметр("Исключить", ИсключитьПродажу);
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция СостояниеБрони(Бронь) Экспорт
    Если Не ЗначениеЗаполнено(Бронь) Тогда
        Возврат "Не записана";
    КонецЕсли;
    Возврат Строка(Бронь.Статус);
КонецФункции

Процедура ПроверитьПродажуПоБрони(Продажа) Экспорт
    Бронь = Продажа.Бронирование;
    Если Не ЗначениеЗаполнено(Бронь) Тогда
        Возврат;
    КонецЕсли;
    Если Не Бронь.Проведен Или Бронь.ПометкаУдаления Тогда
        ВызватьИсключение "Бронь не действует. Выберите проведённую бронь.";
    КонецЕсли;
    Если ЕстьПродажаПоБрони(Бронь, Продажа.Ссылка) Тогда
        ВызватьИсключение "По этой брони уже проведена продажа.";
    КонецЕсли;
    Если Продажа.Организация <> Бронь.Организация Или Продажа.Склад <> Бронь.Склад
        Или Продажа.Покупатель <> Бронь.Покупатель Тогда
        ВызватьИсключение "Организация, склад и покупатель должны совпадать с бронью.";
    КонецЕсли;
    Если Продажа.Дата < Бронь.Дата Тогда
        ВызватьИсключение "Продажа не может быть раньше брони.";
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Бронь.СрокБрони) И Продажа.Дата > Бронь.СрокБрони Тогда
        ВызватьИсключение "Срок действия брони истек. Продажа невозможна.";
    КонецЕсли;

    ТоварыБрони = Бронь.Товары.Выгрузить();
    ТоварыПродажи = Продажа.Товары.Выгрузить();
    ТоварыБрони.Свернуть("Номенклатура, Цена", "Количество");
    ТоварыПродажи.Свернуть("Номенклатура, Цена", "Количество");
    
    Если ТоварыБрони.Количество() <> ТоварыПродажи.Количество() Тогда
        ВызватьИсключение "Продажа по брони должна включать всю забронированную продукцию.";
    КонецЕсли;
    Для Каждого СтрокаБрони Из ТоварыБрони Цикл
        СтрокаПродажи = ТоварыПродажи.Найти(СтрокаБрони.Номенклатура, "Номенклатура");
        Если СтрокаПродажи = Неопределено Тогда
            ВызватьИсключение "Состав продукции не совпадает с бронью.";
        КонецЕсли;
        Если СтрокаПродажи.Количество <> СтрокаБрони.Количество Тогда
            ВызватьИсключение "Количество не совпадает с бронью. Частичная продажа не предусмотрена.";
        КонецЕсли;
        Если СтрокаПродажи.Цена <> СтрокаБрони.Цена Тогда
            ВызватьИсключение "Цена при продаже не может отличаться от цены в документе бронирования.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОстатки(Организация, Склад, Отказ, ДокМоментВремени = Неопределено) Экспорт
    МассивГраниц = Новый Массив;
    Если ДокМоментВремени <> Неопределено Тогда
        МассивГраниц.Добавить(Новый Граница(ДокМоментВремени, ВидГраницы.Включая));
    КонецЕсли;
    МассивГраниц.Добавить(Неопределено); 
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Д.Номенклатура,
    |СУММА(Д.НаСкладе) КАК НаСкладе, СУММА(Д.Резерв) КАК Резерв
    |ИЗ (ВЫБРАТЬ Организация, Склад, Номенклатура,
    |КоличествоОстаток КАК НаСкладе, 0 КАК Резерв
    |ИЗ РегистрНакопления.ОстаткиПродукции.Остатки(&Граница)
    |ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Организация, Склад, Номенклатура,
    |0, КоличествоОстаток ИЗ РегистрНакопления.РезервыПродукции.Остатки(&Граница)) КАК Д
    |СГРУППИРОВАТЬ ПО Д.Организация, Д.Склад, Д.Номенклатура
    |ИМЕЮЩИЕ СУММА(Д.НаСкладе) < 0 ИЛИ СУММА(Д.НаСкладе) - СУММА(Д.Резерв) < 0";
    
    ЗапросРезервы = Новый Запрос("ВЫБРАТЬ Номенклатура ИЗ РегистрНакопления.РезервыПродукции.Остатки(&Граница) ГДЕ КоличествоОстаток < 0");

    Для Каждого ГраницаПроверки Из МассивГраниц Цикл
        ЗапросРезервы.УстановитьПараметр("Граница", ГраницаПроверки);
        Если Не ЗапросРезервы.Выполнить().Пустой() Тогда
            Отказ = Истина;
            Сообщить("Резерв уходит в минус. Проверьте правильность продажи по брони.");
            Возврат;
        КонецЕсли;
        
        Запрос.УстановитьПараметр("Граница", ГраницаПроверки);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Отказ = Истина;
            
            // Считаем красивую цифру нехватки для сообщения
            Нехватка = 0;
            Если Выборка.НаСкладе < 0 Тогда
                Нехватка = -Выборка.НаСкладе;
            ИначеЕсли Выборка.НаСкладе - Выборка.Резерв < 0 Тогда
                Нехватка = -(Выборка.НаСкладе - Выборка.Резерв);
            КонецЕсли;
            
            Сообщить("Недостаточно свободной продукции: " + Строка(Выборка.Номенклатура)
                + ". Нехватка: " + Строка(Нехватка));
        КонецЦикла;
        
        Если Отказ Тогда
            Возврат;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


Функция ПолучитьЦену(ДатаДокумента, Номенклатура) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.Цены.СрезПоследних(&Дата,
    |Номенклатура = &Номенклатура)";
    Запрос.УстановитьПараметр("Дата", КонецДня(ДатаДокумента));
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Цена;
    КонецЕсли;
    Возврат 0;
КонецФункции