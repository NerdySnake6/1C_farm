Перем ДанныеПроверкиРасписания;
Перем ПутьПротоколаРасписания;
Перем КрайнийСрокПроверкиРасписания;

Процедура ПриНачалеРаботыСистемы()
    Для Каждого РежимVanessa Из СтрРазделить("FarmVanessaPrepare;FarmVanessaCleanup", ";") Цикл
        ПрефиксVanessa = РежимVanessa + "=";
        Если Лев(ПараметрЗапуска, СтрДлина(ПрефиксVanessa)) = ПрефиксVanessa Тогда
            КаталогVanessa = Сред(ПараметрЗапуска, СтрДлина(ПрефиксVanessa) + 1);
            Попытка
                Если РежимVanessa = "FarmVanessaPrepare" Тогда
                    СервисФермы.ПодготовитьПрямыеСценарииVanessa(КаталогVanessa);
                Иначе
                    СервисФермы.ОчиститьПрямыеСценарииVanessa(КаталогVanessa);
                КонецЕсли;
            Исключение
                ОшибкаVanessa = Новый ЗаписьТекста(КаталогVanessa + "/fixture-error.txt", КодировкаТекста.UTF8);
                ОшибкаVanessa.ЗаписатьСтроку(ОписаниеОшибки());
                ОшибкаVanessa.Закрыть();
            КонецПопытки;
            ЗавершитьРаботуСистемы(Ложь);
            Возврат;
        КонецЕсли;
    КонецЦикла;
    Если Лев(ПараметрЗапуска, 18) = "FarmEmbeddedTests=" Тогда
        Файл = Новый ЗаписьТекста(Сред(ПараметрЗапуска, 19) + "/embedded-tests.txt", КодировкаТекста.UTF8);
        Попытка
            До = СервисФермы.СнимокДанныхДляАвтотестов();
            Файл.ЗаписатьСтроку(СервисФермы.ПроверитьЗащитуОтЛожногоУспеха());
            Главная = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            Если Главная.Команды.Найти("ОткрытьАвтотестыНаГлавной") = Неопределено Тогда
                ВызватьИсключение "На стартовом рабочем столе нет кнопки Автотесты";
            КонецЕсли;
            Главная.ОткрытьАвтотестыНаГлавной(Неопределено);
            Файл.ЗаписатьСтроку("PASS | Кнопка Автотесты на главной открывает экран проверок");
            Форма = ПолучитьФорму("ОбщаяФорма.Автотесты");
            Форма.Открыть();
            Для Номер = 1 По 2 Цикл
                Форма.ЗапуститьТесты(Неопределено);
                Файл.ЗаписатьСтроку("RUN " + Строка(Номер));
                Файл.ЗаписатьСтроку(Форма.ТекстПротокола);
                Если Не Форма.Успешно Или Форма.Пройдено <> 41 Тогда ВызватьИсключение "Встроенный набор не прошел"; КонецЕсли;
                Если До <> СервисФермы.СнимокДанныхДляАвтотестов() Тогда ВызватьИсключение "Данные базы изменились после теста"; КонецЕсли;
                Файл.ЗаписатьСтроку("PASS | Данные базы сохранены после запуска " + Строка(Номер));
                ДругаяФорма = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
                ДругаяФорма.Открыть();
                Форма.ПроверитьУходСоСтраницы();
                Если Форма.Успешно Или Форма.Пройдено <> 0 Или Не ПустаяСтрока(Форма.ТекстПротокола)
                    Или Форма.Результат.Область(2, 1).Текст <> "НЕ ЗАПУЩЕН" Тогда
                    ВызватьИсключение "Результат не сброшен после ухода со страницы";
                КонецЕсли;
                Файл.ЗаписатьСтроку("PASS | Уход со страницы сбрасывает результат и сохраняет описания");
                ДругаяФорма.Закрыть();
                Форма.Закрыть();
                Форма = ПолучитьФорму("ОбщаяФорма.Автотесты");
                Форма.Открыть();
                Если Форма.Успешно Или Форма.Пройдено <> 0 Или Не ПустаяСтрока(Форма.ТекстПротокола)
                    Или Форма.Результат.Область(2, 1).Текст <> "НЕ ЗАПУЩЕН" Тогда
                    ВызватьИсключение "Повторное открытие восстановило старый результат";
                КонецЕсли;
                Файл.ЗаписатьСтроку("PASS | После закрытия и открытия все проверки не запущены");
            КонецЦикла;
            Файл.ЗаписатьСтроку("COMPLETE");
        Исключение
            Файл.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Файл.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 18) = "FarmScheduleTests=" Тогда
        ПутьПротоколаРасписания = Сред(ПараметрЗапуска, 19) + "/.build/schedule-tests.txt";
        Попытка
            ДанныеПроверкиРасписания = СервисФермы.ПодготовитьПроверкуРасписания(Сред(ПараметрЗапуска, 19));
            КрайнийСрокПроверкиРасписания = ТекущаяДата() + 180;
            ПодключитьОбработчикОжидания("ПроверитьАвтоснятиеБрони", 3);
        Исключение
            ЗавершитьПроверкуРасписания("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 21) = "FarmReservationTests=" Тогда
        СервисФермы.ПроверитьБронирование(Сред(ПараметрЗапуска, 22));
        ПротоколБрони = Новый ЗаписьТекста(Сред(ПараметрЗапуска, 22) + "/.build/reservation-form-tests.txt", КодировкаТекста.UTF8);
        СсылкаБрони = Неопределено;
        Попытка
            СсылкаБрони = СервисФермы.ПодготовитьПроверкуФормыБрони(Сред(ПараметрЗапуска, 22));
            ФормаБрони = ПолучитьФорму("Документ.Бронирование.Форма.Форма", Новый Структура("Ключ", СсылкаБрони));
            ФормаБрони.Открыть();
            Если ФормаБрони.Команды.Найти("ПродатьБронь") = Неопределено Или ФормаБрони.СостояниеБрони <> "Действует" Тогда
                ВызватьИсключение "Не созданы команды или состояние брони";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF01 Форма брони и состояние созданы");
            НоваяФормаБрони = ПолучитьФорму("Документ.Бронирование.Форма.Форма");
            Если НоваяФормаБрони.Элементы.ДействияБрони.Видимость
                Или Не ФормаБрони.Элементы.ДействияБрони.Видимость
                Или ФормаБрони.Элементы.СрокБрони.Родитель.Имя <> "УсловияБрони"
                Или ФормаБрони.Элементы.Товары.Родитель.Имя <> "СоставБрони" Тогда
                ВызватьИсключение "Неверная компоновка формы или видимость действий";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF07 Группы полей и видимость действий");
            ФормаБрони.ПродатьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) <> "Продано" Тогда ВызватьИсключение "Кнопка не продала бронь"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF02 Обработчик Продать по брони создает проведенную продажу");
            ОтказПовтора = Ложь;
            Попытка
                ФормаБрони.ПродатьБронь(Неопределено);
            Исключение
                ОшибкаПовтора = ИнформацияОбОшибке();
                Пока ОшибкаПовтора.Причина <> Неопределено Цикл ОшибкаПовтора = ОшибкаПовтора.Причина; КонецЦикла;
                ОтказПовтора = СервисФермы.ПричинаСовпадает(ОшибкаПовтора.Описание,
                    "По этой брони уже есть проведённая продажа.");
            КонецПопытки;
            Если Не ОтказПовтора Тогда ВызватьИсключение "Повторная продажа по кнопке не отклонена"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF03 Повторная команда продажи отклонена [Ожидаемый отказ подтвержден: по этой брони уже есть продажа]");
            СервисФермы.ОтменитьПродажуТестаБрони(СсылкаБрони);
            ФормаБрони.ОтменитьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) = "Действует" Тогда ВызватьИсключение "Команда не отменила бронь"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF04 Обработчик Отменить бронь снимает резерв");
            Если Не ФормаБрони.Элементы.ИсторияСнятия.Видимость
                Или ФормаБрони.Элементы.ДействияБрони.Видимость
                Или Не ЗначениеЗаполнено(ФормаБрони.Объект.ДатаСнятия)
                Или ФормаБрони.Объект.АвторСнятия <> ИмяПользователя()
                Или ФормаБрони.Объект.ПричинаСнятия <> "Ручная отмена"
                Или Не ФормаБрони.Элементы.ПричинаСнятия.ТолькоПросмотр Тогда
                ВызватьИсключение "Реквизиты ручного снятия брони не подтверждены";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF08 История ручного снятия и видимость действий");
            ОтчетБрони = ПолучитьФорму("Отчет.ДоступностьПродукции.Форма.Форма");
            ОтчетБрони.СформироватьОтчет(Неопределено);
            Если ОтчетБрони.РезультатОтчета.Область(4, 5).Текст <> "Остаток"
                Или ОтчетБрони.РезультатОтчета.Область(4, 6).Текст <> "Забронировано"
                Или ОтчетБрони.РезультатОтчета.Область(4, 7).Текст <> "Доступно" Тогда
                ВызватьИсключение "Отчет не показывает свободный остаток";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF05 Отчет содержит склад, резерв и свободный остаток");
            ПанельБрони = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
            Если ПанельБрони.Команды.Найти("СоздатьБронь") = Неопределено Или ПанельБрони.Команды.Найти("ОткрытьБрони") = Неопределено Тогда
                ВызватьИсключение "Нет команд брони в разделе Продажа";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF06 На странице Продажа есть создание и журнал броней");
            РабочийСтолБрони = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            Если РабочийСтолБрони.Элементы.СоздатьРасход.Родитель.Имя <> "СозданиеДокументов"
                Или РабочийСтолБрони.Элементы.ОткрытьРасходы.Родитель.Имя <> "ЖурналыДокументов" Тогда
                ВызватьИсключение "Команды продажи на рабочем столе не совпали с ожидаемыми";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF09 Создание продажи и журнал находятся в разных группах");
            ПротоколБрони.ЗаписатьСтроку("COMPLETE");
        Исключение
            ПротоколБрони.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Если ЗначениеЗаполнено(СсылкаБрони) Тогда
            Попытка СервисФермы.ЗавершитьПроверкуФормыБрони(СсылкаБрони);
            Исключение ПротоколБрони.ЗаписатьСтроку("ERROR | Очистка: " + ОписаниеОшибки()); КонецПопытки;
        КонецЕсли;
        ПротоколБрони.Закрыть();

        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 9) = "FarmRole=" Тогда
        КаталогПроекта = Сред(ПараметрЗапуска, 10);
        Протокол = Новый ЗаписьТекста(КаталогПроекта + "/.build/role-" + ИмяПользователя() + ".txt", КодировкаТекста.UTF8);
        Попытка
            Протокол.ЗаписатьСтроку(СервисФермы.ПроверитьРабочуюРоль());
            РабочийСтол = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            Если ИмяПользователя() = "Покупка" Тогда
                Если РабочийСтол.Команды.Найти("СоздатьРасход") <> Неопределено Тогда
                    ВызватьИсключение "Покупке показана кнопка продажи";
                КонецЕсли;
            ИначеЕсли ИмяПользователя() = "Продажа" Тогда
                Если РабочийСтол.Команды.Найти("СоздатьПриход") <> Неопределено Тогда
                    ВызватьИсключение "Продаже показана кнопка прихода";
                КонецЕсли;
            КонецЕсли;
            Протокол.ЗаписатьСтроку("PASS | R06 Рабочий стол показывает кнопки по роли");
            Панель = ПолучитьФорму("ОбщаяФорма.Панель" + ИмяПользователя());
            Панель.Открыть();
            Панель.ОткрытьОрганизации(Неопределено);
            Панель.ОткрытьСклады(Неопределено);
            Если ИмяПользователя() = "Покупка" Тогда
                Панель.ОткрытьПоставщиков(Неопределено);
            Иначе
                Панель.ОткрытьПокупателей(Неопределено);
            КонецЕсли;
            Протокол.ЗаписатьСтроку("PASS | R07 Панель раздела и справочники доступны рабочей роли");
        Исключение
            Протокол.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Протокол.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "FarmUsers" Тогда
        СервисФермы.СоздатьУчебныхПользователей();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 10) = "FarmTests=" Тогда
        КаталогПроекта = Сред(ПараметрЗапуска, 11);
        СервисФермы.ВыполнитьПроверки(КаталогПроекта);
        ПротоколФорм = Новый ЗаписьТекста(КаталогПроекта + "/.build/form-tests.txt", КодировкаТекста.UTF8);
        Попытка
            Форма = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            ПротоколФорм.ЗаписатьСтроку("PASS | F06 Рабочий стол и кнопки операций созданы");
            Ссылка = СервисФермы.ПолучитьМолоко();
            Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.Форма", Новый Структура("Ключ", Ссылка));
            ПротоколФорм.ЗаписатьСтроку("PASS | F01 Карточка номенклатуры и поле фотографии созданы");
            Форма = ПолучитьФорму("Документ.Приход.Форма.Форма");
            Форма.Открыть();
            Форма.Объект.Товары.Добавить();
            Если Форма.Объект.Товары.Количество() <> 1 Тогда
                ВызватьИсключение "Не удалось добавить строку в данные формы";
            КонецЕсли;
            ПротоколФорм.ЗаписатьСтроку("PASS | F02 Форма прихода открыта и строка добавлена через данные формы");
            СтрокаТовара = Форма.Объект.Товары[0];
            СтрокаТовара.Количество = 2;
            СтрокаТовара.Цена = 90;
            Форма.Элементы.Товары.ТекущаяСтрока = СтрокаТовара.ПолучитьИдентификатор();
            Форма.СтрокаПриИзменении(Неопределено);
            Если Форма.ИтогоДокумента <> 180 Тогда
                ВызватьИсключение "Итог документа не пересчитан";
            КонецЕсли;
            Форма.УдалитьСтроку(Неопределено);
            Если Форма.Объект.Товары.Количество() <> 0 Или Форма.ИтогоДокумента <> 0 Тогда
                ВызватьИсключение "Строка не удалена или итог не обнулен";
            КонецЕсли;
            ПротоколФорм.ЗаписатьСтроку("PASS | F07 Пересчет итога и удаление строки работают");
            Форма = ПолучитьФорму("Документ.Расход.Форма.Форма");
            ПротоколФорм.ЗаписатьСтроку("PASS | F03 Форма расхода создана");
            Форма = ПолучитьФорму("Отчет.ОстаткиПродукции.Форма.Форма");
            Форма.СформироватьОтчет(Неопределено);
            Форма.ОтборСклад = СервисФермы.ПолучитьПустойСклад();
            Форма.СформироватьОтчет(Неопределено);
            Если Форма.РезультатОтчета.Область(5, 1).Текст <> "По выбранным условиям данных нет" Тогда
                ВызватьИсключение "Фильтр склада не ограничил остатки";
            КонецЕсли;
            Форма.СброситьОтборы(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F04 Остатки, фильтр склада и сброс фильтра работают");
            Форма = ПолучитьФорму("Отчет.ПродажиЗаПериод.Форма.Форма");
            Форма.СформироватьОтчет(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F05 Отчет о продажах сформирован");
            РабочийСтол = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            РабочийСтол.СоздатьПриход(Неопределено);
            РабочийСтол.ОткрытьПриходы(Неопределено);
            РабочийСтол.СоздатьРасход(Неопределено);
            РабочийСтол.ОткрытьРасходы(Неопределено);
            РабочийСтол.ОткрытьПродукцию(Неопределено);
            РабочийСтол.ОткрытьЦены(Неопределено);
            РабочийСтол.ОткрытьОстатки(Неопределено);
            РабочийСтол.ОткрытьПродажи(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F08 Все восемь переходов рабочего стола выполнены");
            Для Повтор = 1 По 2 Цикл
                Панель = ПолучитьФорму("ОбщаяФорма.ПанельПокупка");
                Панель.Открыть();
                Если Панель.Заголовок <> "Покупка продукции"
                    Или Панель.Команды.Найти("СоздатьПриход") = Неопределено
                    Или Панель.Команды.Найти("СоздатьРасход") <> Неопределено Тогда
                    ВызватьИсключение "Неверные команды панели Покупка";
                КонецЕсли;
                Панель.ОткрытьПоставщиков(Неопределено);
                Панель.ОткрытьОрганизации(Неопределено);
                Панель.ОткрытьСклады(Неопределено);
                Панель.Закрыть();
            КонецЦикла;
            ПротоколФорм.ЗаписатьСтроку("PASS | F09 Покупка: повторное открытие панели и справочников");
            Для Повтор = 1 По 2 Цикл
                Панель = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
                Панель.Открыть();
                Если Панель.Заголовок <> "Продажа продукции"
                    Или Панель.Команды.Найти("СоздатьРасход") = Неопределено
                    Или Панель.Команды.Найти("СоздатьПриход") <> Неопределено Тогда
                    ВызватьИсключение "Неверные команды панели Продажа";
                КонецЕсли;
                Панель.ОткрытьПокупателей(Неопределено);
                Панель.ОткрытьОрганизации(Неопределено);
                Панель.ОткрытьСклады(Неопределено);
                Панель.Закрыть();
            КонецЦикла;
            ПротоколФорм.ЗаписатьСтроку("PASS | F10 Продажа: повторное открытие панели и справочников");
        Исключение
            ПротоколФорм.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        ПротоколФорм.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Попытка
        СервисФермы.НастроитьРасписаниеБрони();
    Исключение
        Сообщить("Не удалось настроить расписание снятия просроченных броней: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры


Процедура ПроверитьАвтоснятиеБрони() Экспорт
    Попытка
        Результат = СервисФермы.ПроверитьРезультатРасписания(ДанныеПроверкиРасписания);
        Если Результат <> "" Тогда
            ЗавершитьПроверкуРасписания(Результат);
        ИначеЕсли ТекущаяДата() >= КрайнийСрокПроверкиРасписания Тогда
            ЗавершитьПроверкуРасписания("FAIL | Автоснятие не зафиксировано за 180 секунд");
        КонецЕсли;
    Исключение
        ЗавершитьПроверкуРасписания("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ЗавершитьПроверкуРасписания(Результат)
    ОтключитьОбработчикОжидания("ПроверитьАвтоснятиеБрони");
    Протокол = Новый ЗаписьТекста(ПутьПротоколаРасписания, КодировкаТекста.UTF8);
    Протокол.ЗаписатьСтроку(Результат);
    Протокол.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
