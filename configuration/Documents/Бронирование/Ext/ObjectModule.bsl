Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УчетФермы.ЗаблокироватьУчет();
    
    // ДОБАВЛЕНО УСЛОВИЕ: И Не ДополнительныеСвойства.Свойство("ФиксацияПродажи")
    Если УчетФермы.ЕстьПродажаПоБрони(Ссылка) И Не ДополнительныеСвойства.Свойство("ФиксацияПродажи") Тогда
        ВызватьИсключение "Бронь продана. Сначала отмените проведение связанной продажи.";
    КонецЕсли;
    
    // --- ПУНКТ 3: ЛОГИКА СТАТУСОВ БРОНИ ---
    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Если ДополнительныеСвойства.Свойство("АвтоСнятие") Тогда
            Статус = Перечисления.СтатусыБрони.СнятаАвтоматически;
        ИначеЕсли Статус <> Перечисления.СтатусыБрони.Продано Тогда
            Статус = Перечисления.СтатусыБрони.СнятаВручную;
        КонецЕсли;
        Возврат;
    ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
        Если Статус <> Перечисления.СтатусыБрони.Продано Тогда
            Статус = Перечисления.СтатусыБрони.Действует;
        КонецЕсли;
    ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись И Не Проведен Тогда
        Если Статус = Перечисления.СтатусыБрони.ПустаяСсылка() Тогда
            Статус = Перечисления.СтатусыБрони.Черновик;
        КонецЕсли;
    КонецЕсли;

    // --- ПУНКТ 4: ПРОВЕРКА СРОКА БРОНИ ---
    Если Не ЗначениеЗаполнено(СрокБрони) Тогда
        ВызватьИсключение "Необходимо указать срок действия брони.";
    ИначеЕсли СрокБрони < Дата Тогда
        ВызватьИсключение "Срок действия брони не может быть меньше даты документа.";
    КонецЕсли;

    // --- Стандартные проверки заполненности ---
    Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Склад)
        Или Не ЗначениеЗаполнено(Покупатель) Или Товары.Количество() = 0 Тогда
        ВызватьИсключение "Заполните организацию, склад, покупателя и продукцию.";
    КонецЕсли;
    
    Для Каждого Товар Из Товары Цикл
        Если Не ЗначениеЗаполнено(Товар.Номенклатура) Или Товар.Количество <= 0 Или Товар.Цена <= 0 Тогда
            ВызватьИсключение "Укажите продукцию, положительное количество и цену.";
        КонецЕсли;
        Товар.Сумма = Окр(Товар.Количество * Товар.Цена, 2);
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Для Каждого Товар Из Товары Цикл
        Движение = Движения.РезервыПродукции.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Дата;
        Движение.Организация = Организация;
        Движение.Склад = Склад;
        Движение.Номенклатура = Товар.Номенклатура;
        Движение.Бронирование = Ссылка;
        Движение.Количество = Товар.Количество;
    КонецЦикла;
    Движения.РезервыПродукции.Записать();
    
    // --- ПУНКТ 7: ДОБАВЛЕН МоментВремени() В КОНТРОЛЬ ОСТАТКОВ ---
    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ, МоментВремени());
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    УчетФермы.ЗаблокироватьУчет();
    Если УчетФермы.ЕстьПродажаПоБрони(Ссылка) Тогда
        ВызватьИсключение "Нельзя отменить проданную бронь. Сначала отмените проведение продажи.";
    КонецЕсли;
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Движения.РезервыПродукции.Записать();
    
    // --- ПУНКТ 7: ДОБАВЛЕН МоментВремени() В КОНТРОЛЬ ОСТАТКОВ ---
    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ, МоментВремени());
КонецПроцедуры

Процедура ПередУдалением(Отказ)
    Если Проведен Тогда
        ВызватьИсключение "Сначала отмените проведение документа.";
    КонецЕсли;
КонецПроцедуры