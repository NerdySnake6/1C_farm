&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Бронирование продукции";
    АвтоЗаголовок = Ложь;
    
    Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
        Объект.ДатаСнятия = Дата(1, 1, 1);
        Объект.АвторСнятия = "";
        Объект.ПричинаСнятия = "";
    КонецЕсли;

    Условия = ДобавитьГруппу("УсловияБрони", "Условия бронирования");
    ДобавитьПоле("Дата", "Объект.Дата", "Дата", Условия);
    ДобавитьПоле("Организация", "Объект.Организация", "Организация", Условия);
    ДобавитьПоле("Склад", "Объект.Склад", "Склад", Условия);
    ДобавитьПоле("Покупатель", "Объект.Покупатель", "Покупатель", Условия);

    Если Не ЗначениеЗаполнено(Объект.СрокБрони) И Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
        Объект.СрокБрони = КонецДня(ТекущаяДатаСеанса()) + 259200;
    КонецЕсли;
    ДобавитьПоле("СрокБрони", "Объект.СрокБрони", "Действует до", Условия);
    ДобавитьПоле("Статус", "СостояниеБрони", "Состояние", Условия);
    Элементы.Статус.ТолькоПросмотр = Истина;
    ЦветФона = Новый Цвет(248, 246, 238);
    Элементы.СрокБрони.Формат = "ДФ=dd.MM.yyyy HH:mm";
    
    // Пункт 12 претензии: Пользовательская кнопка "Добавить продукцию" удалена, 
    // чтобы не дублировать стандартную кнопку таблицы.
    Продукция = ДобавитьГруппу("СоставБрони", "Продукция");
    ДобавитьКнопку("УдалитьСтроку", "Удалить выбранную строку", Продукция);
    
    Таблица = Элементы.Добавить("Товары", Тип("ТаблицаФормы"), Продукция);
    Таблица.ПутьКДанным = "Объект.Товары";
    ДобавитьПоле("ТоварыНоменклатура", "Объект.Товары.Номенклатура", "Продукция", Таблица);
    ДобавитьПоле("ТоварыКоличество", "Объект.Товары.Количество", "Количество", Таблица);
    ДобавитьПоле("ТоварыЦена", "Объект.Товары.Цена", "Цена, руб.", Таблица);
    ДобавитьПоле("ТоварыСумма", "Объект.Товары.Сумма", "Сумма, руб.", Таблица);
    
    ДобавитьПоле("ИтогоДокумента", "ИтогоДокумента", "Итого, руб.", Продукция);
    Элементы.ИтогоДокумента.ТолькоПросмотр = Истина;
    Элементы.ИтогоДокумента.Формат = "ЧДЦ=2";
    ИтогоДокумента = Объект.Товары.Итог("Сумма");
    Элементы.ТоварыСумма.ТолькоПросмотр = Истина;
    
    Элементы.ТоварыНоменклатура.УстановитьДействие("ПриИзменении", "ПродукцияПриИзменении");
    Элементы.ТоварыКоличество.УстановитьДействие("ПриИзменении", "СтрокаПриИзменении");
    Элементы.ТоварыЦена.УстановитьДействие("ПриИзменении", "СтрокаПриИзменении");
    
    Действия = ДобавитьГруппу("ДействияБрони", "Действия с бронью");
    ДобавитьКнопку("ПродатьБронь", "Продать по брони", Действия);
    ДобавитьКнопку("ОтменитьБронь", "Отменить бронь", Действия);

    История = ДобавитьГруппу("ИсторияСнятия", "История снятия");
    ДобавитьПоле("ДатаСнятия", "Объект.ДатаСнятия", "Дата и время снятия", История);
    ДобавитьПоле("АвторСнятия", "Объект.АвторСнятия", "Кто снял", История);
    ДобавитьПоле("ПричинаСнятия", "Объект.ПричинаСнятия", "Причина снятия", История);
    Элементы.ДатаСнятия.Формат = "ДФ=dd.MM.yyyy HH:mm:ss";
    Элементы.ДатаСнятия.ТолькоПросмотр = Истина;
    Элементы.АвторСнятия.ТолькоПросмотр = Истина;
    Элементы.ПричинаСнятия.ТолькоПросмотр = Истина;

    // 2. Обновляем доступность кнопок при открытии
    ОбновитьСостояние();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПодключитьОбработчикОжидания("ПроверитьСостояниеПроданнойБрони", 2);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеПроданнойБрони() Экспорт
    // Продажу можно отменить из её списка, пока карточка брони открыта.
    Если СостояниеБрони = "Продано" И Не Модифицированность Тогда
        ОбновитьСостояние();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПриИзменении(Элемент) Экспорт
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
        ИтогоДокумента = Объект.Товары.Итог("Сумма");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриИзменении(Элемент)
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        СтрокаТовара.Цена = ЦенаПродукции(Объект.Дата, СтрокаТовара.Номенклатура);
        СтрокаПриИзменении(Элемент);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаПродукции(ДатаДокумента, Номенклатура)
    Возврат УчетФермы.ПолучитьЦену(ДатаДокумента, Номенклатура);
КонецФункции

&НаСервере
Функция ДобавитьГруппу(Имя, Заголовок)
    Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Заголовок = Заголовок;
    Возврат Группа;
КонецФункции

&НаСервере
Процедура ДобавитьПоле(Имя, Путь, Заголовок, Родитель = Неопределено)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
    Команда = Команды.Добавить(Имя);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
    Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
    Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    Если Имя = "УдалитьСтроку" Или Имя = "СброситьОтборы"
        Или Имя = "ОткрытьПриходы" Или Имя = "ОткрытьРасходы" Тогда
        Кнопка.ЦветФона = Новый Цвет(230, 239, 231);
        Кнопка.ЦветТекста = Новый Цвет(32, 56, 44);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда) Экспорт
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        Объект.Товары.Удалить(СтрокаТовара);
        ИтогоДокумента = Объект.Товары.Итог("Сумма");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродатьБронь(Команда) Экспорт
    Если Модифицированность Тогда
        Сообщить("Сначала запишите и проведите бронь.");
        Возврат;
    КонецЕсли;
    СсылкаПродажи = ПродатьНаСервере();
    Если ЗначениеЗаполнено(СсылкаПродажи) Тогда
        Прочитать();
        ОткрытьФорму("Документ.Расход.ФормаОбъекта", Новый Структура("Ключ", СсылкаПродажи));
    КонецЕсли;
    ОбновитьСостояние();
КонецПроцедуры

&НаСервере
Функция ПродатьНаСервере()
    Если Не Объект.Проведен Тогда
        ВызватьИсключение "Сначала проведите бронь.";
    КонецЕсли;
    Если УчетФермы.ЕстьПродажаПоБрони(Объект.Ссылка) Тогда
        ВызватьИсключение "По этой брони уже есть проведённая продажа.";
    КонецЕсли;
    Продажа = Документы.Расход.СоздатьДокумент();
    Продажа.Дата = Макс(ТекущаяДатаСеанса(), Объект.Дата + 1);
    Продажа.Организация = Объект.Организация;
    Продажа.Склад = Объект.Склад;
    Продажа.Покупатель = Объект.Покупатель;
    Продажа.Бронирование = Объект.Ссылка;
    Для Каждого СтрокаБрони Из Объект.Товары Цикл
        Товар = Продажа.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, СтрокаБрони);
    КонецЦикла;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    
    Возврат Продажа.Ссылка;
КонецФункции

&НаКлиенте
Процедура ОтменитьБронь(Команда) Экспорт
    Если Модифицированность Тогда
        Сообщить("Сначала запишите изменения или закройте форму без сохранения.");
        Возврат;
    КонецЕсли;
    ОтменитьНаСервере();
    Прочитать();
    ОбновитьСостояние();
КонецПроцедуры

&НаСервере
Процедура ОтменитьНаСервере()
    ДокументБрони = Объект.Ссылка.ПолучитьОбъект();
    ДокументБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояние() Экспорт
    // Пункт 11: Кнопки скрыты/недоступны для незаписанной или недействующей брони
    СостояниеБрони = УчетФермы.СостояниеБрони(Объект.Ссылка);
    КнопкиДоступны = Объект.Проведен И СостояниеБрони = "Действует";
    
    Элементы.ДействияБрони.Видимость = КнопкиДоступны;
    Элементы.ИсторияСнятия.Видимость = ЗначениеЗаполнено(Объект.Ссылка)
        И ЗначениеЗаполнено(Объект.ДатаСнятия);
    Элементы.ПродатьБронь.Доступность = КнопкиДоступны
        И (Не ЗначениеЗаполнено(Объект.СрокБрони) Или Объект.СрокБрони >= ТекущаяДатаСеанса());
    Элементы.ОтменитьБронь.Доступность = КнопкиДоступны;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
    ОбновитьСостояние();
КонецПроцедуры