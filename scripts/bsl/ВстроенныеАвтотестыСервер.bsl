// Автотесты используют собственные объекты и не заполняют рабочие справочники.
Функция ПроверитьЗащитуОтЛожногоУспеха() Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    ОтказТеста = Ложь;
    // Объект без метода Записать вызывает техническую, а не бизнес-ошибку.
    Попытка
        ОжидаетсяОтказ(Новый Структура, "B03 Контроль посторонней ошибки", Протокол);
    Исключение
        ОтказТеста = Истина;
    КонецПопытки;
    Если Не ОтказТеста Или Протокол.Количество() <> 1 Или Лев(Протокол[0], 7) <> "FAIL | " Тогда
        ВызватьИсключение "Посторонняя техническая ошибка ошибочно принята за ожидаемый отказ";
    КонецЕсли;
    Если ПричинаСовпадает("Операция неожиданно разрешена", "Недостаточно свободной продукции:") Тогда
        ВызватьИсключение "Проверка причины отказа принимает успешную операцию";
    КонецЕсли;
    Возврат "PASS | Посторонняя техническая ошибка отклонена: " + Протокол[0];
КонецФункции

Функция НовыйОбъектАвтотестов(Менеджер, Имя, Ссылки)
    Объект = Менеджер.СоздатьЭлемент();
    Объект.Наименование = Имя;
    Объект.Записать();
    Ссылки.Добавить(Объект.Ссылка);
    Возврат Объект.Ссылка;
КонецФункции

Функция ПодготовитьВстроенныеАвтотесты() Экспорт
    ПроверитьАдминистратора();
    Каталог = ПолучитьИмяВременногоФайла();
    СоздатьКаталог(Каталог + "/.build");
    Ссылки = Новый Массив;
    Префикс = "Автотест " + Лев(Строка(Новый УникальныйИдентификатор), 8) + " ";
    Данные = Новый Структура;
    Данные.Вставить("Организация", НовыйОбъектАвтотестов(Справочники.Организации, Префикс + "Ферма", Ссылки));
    Данные.Вставить("Склад", НовыйОбъектАвтотестов(Справочники.Склады, Префикс + "Склад", Ссылки));
    Данные.Вставить("ДругойСклад", НовыйОбъектАвтотестов(Справочники.Склады, Префикс + "Другой склад", Ссылки));
    Данные.Вставить("Поставщик", НовыйОбъектАвтотестов(Справочники.Поставщики, Префикс + "Поставщик", Ссылки));
    Данные.Вставить("Покупатель", НовыйОбъектАвтотестов(Справочники.Покупатели, Префикс + "Покупатель", Ссылки));
    Данные.Вставить("ДругойПокупатель", НовыйОбъектАвтотестов(Справочники.Покупатели, Префикс + "Другой покупатель", Ссылки));
    Продукция = Новый Массив;
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Молоко", Ссылки));
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Творог", Ссылки));
    Продукция.Добавить(НовыйОбъектАвтотестов(Справочники.Номенклатура, Префикс + "Сметана", Ссылки));
    Цены = Новый Массив;
    Цены.Добавить(90);
    Цены.Добавить(360);
    Цены.Добавить(280);
    Данные.Вставить("Продукция", Продукция);
    Данные.Вставить("Цены", Цены);
    Возврат Новый Структура("Каталог,Данные,Ссылки", Каталог, Данные, Ссылки);
КонецФункции

Процедура ВыполнитьВстроенныеПроверкиДанных(Запуск) Экспорт
    ПроверитьАдминистратора();
    ПроверитьБронирование(Запуск.Каталог, Запуск.Данные);
КонецПроцедуры

Функция БроньВстроенногоТеста(Запуск) Экспорт
    ПроверитьАдминистратора();
    Приход = Документы.Приход.СоздатьДокумент();
    Приход.Дата = ТекущаяДатаСеанса();
    Приход.Организация = Запуск.Данные.Организация;
    Приход.Склад = Запуск.Данные.Склад;
    Приход.Поставщик = Запуск.Данные.Поставщик;
    Строка = Приход.Товары.Добавить();
    Строка.Номенклатура = Запуск.Данные.Продукция[0];
    Строка.Количество = 75;
    Строка.Цена = 90;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Бронь = ТестоваяБронь(Запуск.Данные, 5);
    Бронь.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Бронь.Ссылка;
КонецФункции

Функция ПродажиВстроенногоТеста(Запуск) Экспорт
    ПроверитьАдминистратора();
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Организация = &Организация");
    Запрос.УстановитьПараметр("Организация", Запуск.Данные.Организация);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

Процедура ОчиститьВстроенныеАвтотесты(Запуск, Протокол) Экспорт
    ПроверитьАдминистратора();
    Для Каждого Вид Из СтрРазделить("Расход;Бронирование;Приход", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ." + Вид + " ГДЕ Организация = &Организация");
        Запрос.УстановитьПараметр("Организация", Запуск.Данные.Организация);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Попытка
                Документ = Выборка.Ссылка.ПолучитьОбъект();
                Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
                Документ.Удалить();
            Исключение
                Протокол.Добавить("ERROR | Очистка документов: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
    КонецЦикла;
    Индекс = Запуск.Ссылки.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Попытка
            Запуск.Ссылки[Индекс].ПолучитьОбъект().Удалить();
        Исключение
            Протокол.Добавить("ERROR | Очистка справочников: " + ОписаниеОшибки());
        КонецПопытки;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

Функция ЗавершитьВстроенныеАвтотесты(Запуск, ПротоколФорм) Экспорт
    ПроверитьАдминистратора();
    Линии = Новый Массив;
    Попытка
        Чтение = Новый ЧтениеТекста(Запуск.Каталог + "/.build/reservation-tests.txt", КодировкаТекста.UTF8);
        Строка = Чтение.ПрочитатьСтроку();
        Пока Строка <> Неопределено Цикл
            Линии.Добавить(Строка);
            Строка = Чтение.ПрочитатьСтроку();
        КонецЦикла;
        Чтение.Закрыть();
    Исключение
        Линии.Добавить("ERROR | Протокол бизнес-логики: " + ОписаниеОшибки());
    КонецПопытки;
    Для Каждого Строка Из ПротоколФорм Цикл Линии.Добавить(Строка); КонецЦикла;
    ОчиститьВстроенныеАвтотесты(Запуск, Линии);
    Ожидаемые = Новый Соответствие;
    Для Индекс = 1 По 32 Цикл Ожидаемые.Вставить("B" + Прав("0" + Строка(Индекс), 2), 0); КонецЦикла;
    Для Индекс = 1 По 9 Цикл Ожидаемые.Вставить("BF" + Прав("0" + Строка(Индекс), 2), 0); КонецЦикла;
    Успешно = Истина;
    Завершено = 0;
    Пройдено = 0;
    Для Каждого Строка Из Линии Цикл
        Если Лев(Строка, 7) = "PASS | " Тогда
            Код = СтрРазделить(Сред(Строка, 8), " ")[0];
            Счетчик = Ожидаемые.Получить(Код);
            Если Счетчик = Неопределено Тогда
                Успешно = Ложь;
            Иначе
                Ожидаемые.Вставить(Код, Счетчик + 1);
                Пройдено = Пройдено + 1;
            КонецЕсли;
        ИначеЕсли Строка = "COMPLETE" Тогда
            Завершено = Завершено + 1;
        Иначе
            Успешно = Ложь;
        КонецЕсли;
    КонецЦикла;
    Для Каждого Пара Из Ожидаемые Цикл
        Если Пара.Значение <> 1 Тогда
            Успешно = Ложь;
            Линии.Добавить("ERROR | Неполная проверка " + Пара.Ключ);
        КонецЕсли;
    КонецЦикла;
    Успешно = Успешно И Пройдено = 41 И Завершено = 2;
    Попытка УдалитьФайлы(Запуск.Каталог); Исключение
        Успешно = Ложь;
        Линии.Добавить("ERROR | Временный каталог: " + ОписаниеОшибки());
    КонецПопытки;
    Возврат Новый Структура("Успешно,Пройдено,Линии", Успешно, Пройдено, Линии);
КонецФункции

Функция СнимокДанныхДляАвтотестов() Экспорт
    ПроверитьАдминистратора();
    Снимок = Новый Массив;
    Для Каждого Имя Из СтрРазделить("Организации;Склады;Поставщики;Покупатели;Номенклатура", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ Справочник." + Имя + " УПОРЯДОЧИТЬ ПО Ссылка");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("Приход;Расход;Бронирование", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ Документ." + Имя + " УПОРЯДОЧИТЬ ПО Ссылка");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("ОстаткиПродукции;РезервыПродукции", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрНакопления." + Имя + " УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
        Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.Цены УПОРЯДОЧИТЬ ПО Период, Номенклатура");
    Снимок.Добавить(Запрос.Выполнить().Выгрузить());
    Возврат ЗначениеВСтрокуВнутр(Снимок);
КонецФункции
